<% project = @record&.project %>
<% approved = @record&.approved? %>
<% feedback = @record&.feedback %>

<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;line-height:1.3;color:#1a1a2e;">
  <%= approved ? "Your funding request was approved!" : "Your funding request needs changes" %>
</h1>

<% if approved %>
  <p style="margin:0 0 16px;font-size:15px;line-height:1.55;color:#3a3a4a;">
    <% if project && @record.issues_grant? %>
      <strong><%= project.title %></strong> is approved for <strong>$<%= @record.final_amount_dollars %></strong> in funding<% if @actor %>, reviewed by <strong>@<%= @actor.display_name %></strong><% end %>.
    <% elsif project %>
      <strong><%= project.title %></strong> is approved<% if @actor %>, reviewed by <strong>@<%= @actor.display_name %></strong><% end %>.
    <% else %>
      Your hardware funding request was approved.
    <% end %>
  </p>

  <p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#3a3a4a;">
    Your project has moved to the build phase. Log your build hours with a timelapse, then ship when you're ready.
  </p>
<% else %>
  <p style="margin:0 0 16px;font-size:15px;line-height:1.55;color:#3a3a4a;">
    <% if project %>
      <strong><%= project.title %></strong> isn't approved yet<% if @actor %>, reviewed by <strong>@<%= @actor.display_name %></strong><% end %>.
    <% else %>
      Your hardware funding request was sent back.
    <% end %>
  </p>

  <% if feedback.present? %>
    <p style="margin:0 0 8px;font-size:15px;line-height:1.55;color:#3a3a4a;"><strong>Reviewer feedback:</strong></p>
    <p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#3a3a4a;"><%= feedback %></p>
  <% end %>

  <p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#3a3a4a;">
    Update your request and resubmit when you're ready.
  </p>
<% end %>

<div style="margin:24px 0 4px;">
  <a href="<%= project ? project_url(project) : root_url %>" style="display:inline-block;padding:11px 22px;background:#1a1a2e;color:#ffffff;text-decoration:none;border-radius:999px;font-weight:600;font-size:14px;line-height:1;">View project</a>
</div>
