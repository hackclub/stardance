<% mention = @record&.project_mention %>
<% project = mention&.project %>
<% note = @record&.reason %>
<% heading = { "approve" => "Your viral mention was approved!", "reject" => "Your viral mention wasn't approved" }
     .fetch(@record&.action, "Your viral mention is back in review") %>

<h1 style="margin:0 0 12px;font-size:22px;font-weight:700;line-height:1.3;color:#1a1a2e;"><%= heading %></h1>

<p style="margin:0 0 16px;font-size:15px;line-height:1.55;color:#3a3a4a;">
  <% if @record&.action == "approve" %>
    Your viral mention<% if project %> for <strong><%= project.title %></strong><% end %> qualified for the <strong><%= @record.tier.to_s.capitalize %></strong> virality bonus<% if @actor %>, reviewed by <strong>@<%= @actor.display_name %></strong><% end %>. Your stardust is on its way.
  <% elsif @record&.action == "reject" %>
    Your viral mention<% if project %> for <strong><%= project.title %></strong><% end %> didn't qualify for the virality bonus<% if @actor %>, reviewed by <strong>@<%= @actor.display_name %></strong><% end %>.
  <% else %>
    A reviewer reopened your viral mention<% if project %> for <strong><%= project.title %></strong><% end %>. Your virality bonus has been recalculated.
  <% end %>
</p>

<% if mention %>
  <p style="margin:0 0 16px;font-size:15px;line-height:1.55;color:#3a3a4a;word-break:break-all;"><strong>Mention:</strong> <%= mention.url %></p>
<% end %>

<% if note.present? %>
  <p style="margin:0 0 8px;font-size:15px;line-height:1.55;color:#3a3a4a;"><strong>Reviewer note:</strong></p>
  <p style="margin:0 0 24px;font-size:15px;line-height:1.55;color:#3a3a4a;"><%= note %></p>
<% end %>

<div style="margin:24px 0 4px;">
  <a href="<%= project ? project_url(project) : root_url %>" style="display:inline-block;padding:11px 22px;background:#1a1a2e;color:#ffffff;text-decoration:none;border-radius:999px;font-weight:600;font-size:14px;line-height:1;">View project</a>
</div>
