<%# Explain-then-start control in the widget body. Which run is on offer is
    decided server side by User#startable_sticky_streak_kind; the view only
    picks the words. %>
<% copy = sticky_streak_start_copy(kind) %>
<details class="sticky-start">
  <summary class="action-btn action-btn--secondary action-btn--small sticky-start__summary">
    <%= copy.summary %>
  </summary>
  <p class="sticky-start__body"><%= copy.body %></p>
  <% if forfeiting.positive? %>
    <p class="sticky-start__warning">
      You still have <%= pluralize(forfeiting, "sticker") %> to claim from your last run.
      Claim <%= forfeiting == 1 ? "it" : "them" %> first: restarting gives up anything left unclaimed.
    </p>
  <% end %>
  <%= button_to copy.cta, sticky_streak_path,
        class: "action-btn action-btn--primary action-btn--small sticky-start__btn",
        data: { turbo: false } %>
</details>
