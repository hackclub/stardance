<%# Always-present claim control under the streak calendar. A claimable day
    links into the normal shop item page, carrying the run and the day as the
    redemption gate, so the usual address picker and checkout apply. %>
<% runs.each do |run| %>
  <% day = run.latest_claimable_day %>
  <% item = run.rewards_by_day[day].shop_item %>
  <%= link_to shop_item_path(item, sticky_streak_day: day, sticky_streak_id: run.id),
        class: "action-btn action-btn--primary action-btn--small sticky-claim",
        data: { turbo: false } do %>
    <span class="sticky-claim__day">Claim day <%= day %></span>
    <span class="sticky-claim__item"><%= item.name %></span>
  <% end %>
<% end %>
<% if runs.empty? && current_run %>
  <span class="sticky-claim sticky-claim--idle">
    <%= sticky_streak_idle_claim_label(current_run) %>
  </span>
<% end %>
