<% content_for :title, @mission.name %>
<% content_for :og_title, "#{@mission.name} — Stardance Mission" %>
<% content_for :og_description, truncate(@mission.description.to_s, length: 200) %>
<% content_for :og_image, mission_og_image_url(@mission.slug, format: :png) rescue nil %>

<div class="app-layout">
  <div class="app-layout__main">
    <article class="mission-home">
      <p class="mission-home__crumb">
        <span class="mission-home__crumb-links">
          <%= link_to "Missions", missions_path, class: "mission-home__crumb-link" %>
          <% if policy(@mission).manage? %>
            <span class="mission-home__crumb-dot" aria-hidden="true">·</span>
            <%= link_to "Manage", edit_admin_mission_path(@mission.slug), class: "mission-home__crumb-link" %>
          <% end %>
          <% if policy(@mission).review_queue? %>
            <span class="mission-home__crumb-dot" aria-hidden="true">·</span>
            <%= link_to "Review", admin_mission_submissions_path(@mission.slug), class: "mission-home__crumb-link" %>
          <% end %>
        </span>
      </p>

      <% if @mission.banner.attached? %>
        <div class="mission-home__banner">
          <%= image_tag @mission.banner, alt: "", class: "mission-home__banner-img" %>
        </div>
      <% end %>

      <% if !@prerequisites_met && @unmet_prerequisites.any? %>
        <div class="mission-home__locked">
          <p class="mission-home__locked-message">
            This mission is locked. Complete
            <% @unmet_prerequisites.each_with_index do |prereq, i| %>
              <%= ", " if i > 0 && i < @unmet_prerequisites.length - 1 %>
              <%= " and " if i > 0 && i == @unmet_prerequisites.length - 1 %>
              <%= link_to prereq.name, mission_path(prereq.slug), class: "mission-home__locked-link" %>
            <% end %>
            first to unlock it!
          </p>
        </div>
      <% end %>

      <section class="mission-home__hero">
        <%# star creature peeking off the top-right of the hero card %>
        <%= image_tag "missions/card-star.png", alt: "",
              aria: { hidden: "true" }, class: "mission-home__hero-creature" %>

        <div class="mission-home__hero-top">
          <%= render "missions/mission_patch", mission: @mission, size: 132 %>

          <div class="mission-home__hero-text">
            <ul class="mission-home__hero-chips">
              <% status_label, status_glyph = case @progress_state
                 when :completed   then [ "completed",   "✓" ]
                 when :in_voting   then [ "in voting",   "◉" ]
                 when :in_review   then [ "in review",   "⊙" ]
                 when :in_progress then [ "in progress", "◐" ]
                 else                   [ "not started", "○" ]
                 end %>
              <li class="mission-home__hero-chip mission-home__hero-chip--status mission-home__hero-chip--status-<%= @progress_state.to_s.dasherize %>">
                <span class="mission-home__hero-chip-dot" aria-hidden="true"><%= status_glyph %></span> <%= status_label %>
              </li>
              <% if @mission.hardware? %>
                <li class="mission-home__hero-chip mission-home__hero-chip--hardware">hardware</li>
              <% end %>
              <% if @mission.difficulty.present? %>
                <li class="mission-home__hero-chip mission-home__hero-chip--difficulty mission-home__hero-chip--difficulty-<%= @mission.difficulty %>">
                  <%= @mission.difficulty %>
                </li>
              <% end %>
              <% if @estimated_label.present? %>
                <li class="mission-home__hero-chip mission-home__hero-chip--time"><%= @estimated_label %></li>
              <% end %>
              <% sections_count = @mission.external_guide? ? @mission.guide_sections_count : @guide_outline.length %>
              <% if sections_count&.positive? %>
                <li class="mission-home__hero-chip mission-home__hero-chip--sections"><%= pluralize(sections_count, "section") %></li>
              <% end %>
            </ul>

            <h1 class="mission-home__hero-title">
              <em class="mission-home__hero-title-accent"><%= @mission.name %></em>
            </h1>
          </div>
        </div>

        <div class="mission-home__hero-brief"><%= md(@mission.description) %></div>

        <% unless @mission.available_to_builders? %>
          <p class="mission-home__windowed-banner">
            <% if @mission.coming_soon? %>
              Lifts off <%= @mission.start_at.strftime("%b %-d, %Y") %> — see you there.
            <% elsif @mission.ended? %>
              This mission has wrapped — feel free to read the walkthrough anyway.
            <% else %>
              This mission is taking a quick break.
            <% end %>
          </p>
        <% end %>

        <% has_attach_choices = @attachable_projects&.any? || @continuable_projects&.any? %>
        <% has_three_actions = !@active_project && has_attach_choices && @mission.has_guide? %>
        <div class="mission-home__hero-actions<%= " mission-home__hero-actions--spread" if has_three_actions %>">
          <% if @active_project %>
            <%= link_to "View my project",
                        project_path(@active_project),
                        data: { turbo: false },
                        class: "action-btn action-btn--large action-btn--primary" %>
          <% elsif @prerequisites_met %>
            <%# Follow-up missions lead with continuing a prerequisite project %>
            <% continue_flow = @continuable_projects&.any? %>
            <% if continue_flow %>
              <button type="button"
                      class="action-btn action-btn--large action-btn--primary"
                      onclick="document.getElementById('attach-mission-modal').showModal()">
                Continue project
              </button>
            <% end %>
            <%# Onboarded builders (HCA-linked with a project) would be bounced
                back to an existing draft by the setup flow's redirect_if_setup_complete
                guard, so they create through the standard projects#create path —
                which attaches the mission and applies hardware conversion. New
                builders still funnel through the onboarding setup step. %>
            <% onboarded = current_user&.hca_linked? && current_user.projects.exists? %>
            <% create_cta_class = "action-btn action-btn--large #{continue_flow ? "action-btn--secondary" : "action-btn--primary"}" %>
            <% if onboarded %>
              <%# Named up front via the same prompt as /projects/new. New builders
                  skip it: the setup wizard has its own naming step. %>
              <%= form_with url: projects_path, method: :post, data: { turbo: false }, class: "mission-home__cta-form" do %>
                <%= hidden_field_tag :mission_slug, @mission.slug %>
                <button type="button" class="<%= create_cta_class %>"
                        onclick="openNamePrompt(this, 'name-prompt-mission-cta')">
                  Create a project
                </button>
                <%= render "projects/name_prompt", id: "name-prompt-mission-cta" %>
              <% end %>
            <% else %>
              <%= button_to "Create a project",
                            projects_setup_submit_mission_path,
                            method: :post,
                            params: { mission_slug: @mission.slug },
                            data: { turbo: false },
                            form: { class: "mission-home__cta-form" },
                            class: create_cta_class %>
            <% end %>
            <% if !continue_flow && has_attach_choices %>
              <button type="button"
                      class="action-btn action-btn--large action-btn--secondary"
                      onclick="document.getElementById('attach-mission-modal').showModal()">
                Attach to project
              </button>
            <% end %>
          <% end %>
          <% if @mission.has_guide? %>
            <%= link_to (@active_project ? "View guide" : "Preview guide"),
                        @mission.external_guide? ? @mission.guide_url : guide_mission_path(@mission.slug),
                        target: @mission.external_guide? ? "_blank" : nil,
                        rel: @mission.external_guide? ? "noopener" : nil,
                        data: { turbo: false },
                        class: "action-btn action-btn--large action-btn--secondary" %>
          <% end %>
        </div>
      </section>

      <div class="mission-home__columns">
        <%# Submission requirements card %>
        <% if @mission.submission_guide.present? %>
          <section class="mission-home__card mission-home__requirements"
                   aria-labelledby="mission-home-requirements">
            <h2 id="mission-home-requirements" class="mission-home__card-title">
              Submission <em class="mission-home__card-title-accent">requirements</em>
            </h2>
            <%= render "missions/submission_requirements", mission: @mission %>
          </section>
        <% end %>

        <%# Prizes card — always shown so every mission surfaces its rating status %>
        <% has_stardust = @mission.fixed_stardust_payout&.positive? %>
        <section class="mission-home__card mission-home__rewards"
                 aria-labelledby="mission-home-rewards">
            <h2 id="mission-home-rewards" class="mission-home__card-title">
              <em class="mission-home__card-title-accent">Prizes</em>
            </h2>
            <ul class="mission-home__prize-list">
              <% tones = %w[yellow lilac peach mint] %>
              <% tone_idx = 0 %>
              <%# The kit is claimed at design approval; the voting/stardust reward
                  and any after-ship prizes come after building. Only a mission with
                  a design kit is split into labelled sections. %>
              <% design_prizes = @ordered_prizes.select(&:after_design?) %>
              <% building_prizes = @ordered_prizes.reject(&:after_design?) %>
              <% split_sections = design_prizes.any? %>

              <% if split_sections %>
                <li class="mission-home__prize-group-label">After design</li>
                <% design_prizes.each do |prize| %>
                  <%= render "missions/prize_tile", prize: prize, tone: tones[tone_idx % tones.length] %>
                  <% tone_idx += 1 %>
                <% end %>
                <li class="mission-home__prize-group-label">After building</li>
              <% end %>

              <%= render "missions/rating_status", mission: @mission %>
              <% if has_stardust %>
                <li class="mission-home__prize mission-home__prize--<%= tones[tone_idx % tones.length] %>">
                  <div class="mission-home__prize-tile">
                    <%= stardust_icon(extra_class: "mission-home__prize-img") %>
                  </div>
                  <div class="mission-home__prize-body">
                    <p class="mission-home__prize-title"><%= @mission.fixed_stardust_payout %> stardust</p>
                    <p class="mission-home__prize-blurb">Yours to spend in the shop!</p>
                  </div>
                </li>
                <% tone_idx += 1 %>
              <% end %>
              <% building_prizes.each do |prize| %>
                <%= render "missions/prize_tile", prize: prize, tone: tones[tone_idx % tones.length] %>
                <% tone_idx += 1 %>
              <% end %>
              <% @shop_unlocks.each_with_index do |shop_unlock, idx| %>
                <% tone = tones[(tone_idx + idx) % tones.length] %>
                <li class="mission-home__prize mission-home__prize--<%= tone %>">
                  <div class="mission-home__prize-tile">
                    <% if shop_unlock.shop_item.respond_to?(:image) && shop_unlock.shop_item.image.respond_to?(:attached?) && shop_unlock.shop_item.image.attached? %>
                      <%= image_tag shop_unlock.shop_item.image, alt: "", class: "mission-home__prize-img" %>
                    <% else %>
                      <svg viewBox="0 0 24 24" width="28" height="28" class="mission-home__prize-glyph" aria-hidden="true">
                        <path d="M12 1.5 13.6 10.4 22.5 12 13.6 13.6 12 22.5 10.4 13.6 1.5 12 10.4 10.4Z" />
                      </svg>
                    <% end %>
                  </div>
                  <div class="mission-home__prize-body">
                    <p class="mission-home__prize-title">Unlocks <%= link_to shop_unlock.shop_item.name, shop_item_path(shop_unlock.shop_item) %></p>
                    <p class="mission-home__prize-blurb">Allows you to get <%= shop_unlock.shop_item.name %> from the shop!</p>
                  </div>
                </li>
              <% end %>
              <% @unlocked_missions.each_with_index do |unlocked, idx| %>
                <% tone = tones[(tone_idx + @shop_unlocks.size + idx) % tones.length] %>
                <li class="mission-home__prize mission-home__prize--<%= tone %>">
                  <div class="mission-home__prize-tile">
                    <% if unlocked.icon.attached? %>
                      <%= image_tag unlocked.icon, alt: "", class: "mission-home__prize-img mission-home__prize-img--contain" %>
                    <% else %>
                      <svg viewBox="0 0 24 24" width="28" height="28" class="mission-home__prize-glyph" aria-hidden="true">
                        <path d="M12 1.5 13.6 10.4 22.5 12 13.6 13.6 12 22.5 10.4 13.6 1.5 12 10.4 10.4Z" />
                      </svg>
                    <% end %>
                  </div>
                  <div class="mission-home__prize-body">
                    <p class="mission-home__prize-title">Unlocks <%= link_to unlocked.name, mission_path(unlocked.slug) %></p>
                    <p class="mission-home__prize-blurb">Completing this mission will unlock the <%= unlocked.name %> mission</p>
                  </div>
                </li>
              <% end %>
            </ul>
        </section>
      </div>

      <% if @gallery_projects.any? %>
        <section class="mission-home__gallery" aria-labelledby="mission-home-gallery">
          <h2 id="mission-home-gallery" class="mission-home__section-title">
            Projects for this <em class="mission-home__section-title-accent">mission</em>
          </h2>
          <div class="mission-home__gallery-grid" role="list">
            <% @gallery_projects.each do |project| %>
              <div class="mission-home__gallery-item" role="listitem">
                <% if @approved_project_ids.include?(project.id) %>
                  <span class="mission-home__gallery-badge mission-home__gallery-badge--approved">Completed</span>
                <% else %>
                  <span class="mission-home__gallery-badge mission-home__gallery-badge--in-progress">In progress</span>
                <% end %>
                <%= render Projects::ShelfCardComponent.new(project: project) %>
              </div>
            <% end %>
            <% if @has_more_gallery %>
              <%= turbo_frame_tag "gallery-page-2" do %>
                <div class="mission-home__gallery-show-more-wrapper">
                  <%= link_to "Show more", gallery_mission_path(@mission.slug, page: 2),
                        class: "mission-home__gallery-show-more" %>
                </div>
              <% end %>
            <% end %>
          </div>
        </section>
      <% end %>
    </article>
  </div>

  <% if @attachable_projects&.any? || @continuable_projects&.any? %>
    <% modal_title = @continuable_projects&.any? ? "Continue a project" : "Attach to project" %>
    <%= render layout: "shared/modal", locals: { id: "attach-mission-modal", title: modal_title, class_name: "attach-mission-modal" } do %>
      <p class="attach-mission-modal__desc">Pick a project to take on <strong><%= @mission.name %></strong>:</p>
      <ul class="attach-mission-modal__list">
        <% @attachable_projects&.each do |project| %>
          <li class="attach-mission-modal__item">
            <span class="attach-mission-modal__project-name"><%= truncate(project.title, length: 50) %></span>
            <%= button_to "Attach",
                          project_mission_path(project),
                          method: :post,
                          params: { mission_slug: @mission.slug },
                          data: { turbo: false },
                          class: "action-btn action-btn--small action-btn--primary" %>
          </li>
        <% end %>
        <% prerequisites_by_id = @mission.prerequisites.index_by(&:id) %>
        <% @continuable_projects&.each do |project| %>
          <% shipped_prerequisite = prerequisites_by_id[project.shipped_prerequisite_mission_id] %>
          <li class="attach-mission-modal__item">
            <span class="attach-mission-modal__project-name"><%= truncate(project.title, length: 50) %></span>
            <% if shipped_prerequisite %>
              <span class="attach-mission-modal__badge">Shipped <%= shipped_prerequisite.name %></span>
            <% end %>
            <%= button_to "Continue",
                          project_mission_path(project),
                          method: :post,
                          params: { mission_slug: @mission.slug },
                          data: { turbo: false },
                          class: "action-btn action-btn--small action-btn--primary" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render DiscoverRailComponent.new %>
</div>
