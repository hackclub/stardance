<% content_for :title, "Import Devlogs" %>

<h1>Import Devlogs from Journal</h1>

<div class="card mb-3">
  <h3>How to use</h3>
  <p>Paste the JSON array generated by the journal parser. Each entry creates a devlog on the specified project, backdated to the given date.</p>
  <details>
    <summary>JSON schema & allowed hosts</summary>
    <pre><code>[{ "project_id": 12, "body": "...", "hours": 2.5, "image": "https://...", "created_at": "2025-06-30" }]</code></pre>
    <p><strong>Allowed image hosts:</strong> <%= DevlogImportService::ALLOWED_HOSTS.join(", ") %></p>
  </details>
</div>

<%= form_with url: admin_devlog_imports_path, method: :post, local: true do |f| %>
  <div class="card">
    <label for="devlog_json">Devlog JSON</label>
    <%= text_area_tag :devlog_json, @json_input, rows: 20, class: "form-control font-mono", placeholder: "Paste JSON array here..." %>

    <div class="mt-3 d-flex gap-2">
      <%= button_tag "Validate (dry run)", type: :submit, name: "dry_run", value: "1", class: "btn-secondary" %>
      <%= button_tag "Import devlogs", type: :submit, class: "btn-primary", data: { confirm: "This will create devlogs on the specified projects. Are you sure?" } %>
    </div>
  </div>
<% end %>
