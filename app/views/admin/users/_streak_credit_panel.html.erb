<%# Everything inside the credit-a-streak-day modal. It lives in its own frame
    so crediting or revoking a day swaps the panel in place and leaves the
    dialog open, rather than redirecting the whole page and closing it. %>
<%= turbo_frame_tag "admin_user_streak_credit_panel" do %>
  <% if local_assigns[:message].present? %>
    <p class="<%= class_names("admin-user-show__streak-credit-message",
                              "admin-user-show__streak-credit-message--alert" => local_assigns[:message_tone] == :alert) %>">
      <%= message %>
    </p>
  <% end %>

  <form action="<%= admin_user_streak_credits_path(user) %>" method="post" data-controller="streak-day-picker">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= label_tag :activity_date, "Day to credit" %>
    <%= date_field_tag :activity_date, user.streak_today_date - 1.day,
          max: user.streak_today_date, required: true, autocomplete: "off",
          data: { streak_day_picker_target: "date" } %>

    <%= render "admin/users/streak_calendar", user: user, date: user.streak_calendar_month %>

    <%= label_tag :reason, "Reason" %>
    <%= text_area_tag :reason, "", placeholder: "Why this day is being credited...", required: true %>
    <button type="submit">Credit day</button>
    <button type="button" onclick="document.getElementById('credit-streak-day-modal').close()">Cancel</button>
  </form>

  <% credits = user.streak_credits %>
  <% if credits.any? %>
    <h4 class="admin-user-show__section-title">Already credited</h4>
    <ul class="admin-user-show__streak-credits">
      <% credits.each do |credit| %>
        <li class="admin-user-show__streak-credit">
          <div>
            <strong><%= credit.activity_date.to_fs(:long) %></strong>
            <span class="admin-user-show__streak-credit-meta">
              <%= credit.manual_credit_reason %> (<%= credit.manual_credit_by&.display_name || "unknown" %>)
            </span>
          </div>
          <%= button_to "Revoke", admin_user_streak_credit_path(user, credit), method: :delete,
              class: "admin-user-show__inline-action",
              form: { onsubmit: "return confirm(#{("Remove the credit for #{credit.activity_date.to_fs(:long)}?").to_json})" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
