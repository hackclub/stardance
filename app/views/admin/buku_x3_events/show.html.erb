<% content_for :title, "the jim takeover" %>

<div class="admin-dashboard">
  <header>
    <%= link_to "← admin dashboard", admin_root_path %>
    <h1>the jim takeover</h1>
  </header>

  <% if @poll_tally %>
    <section aria-labelledby="jimberjake-poll-heading">
      <h2 id="jimberjake-poll-heading">jimberjake poll</h2>
      <p class="admin-dashboard__metric-note">one vote per account · all-time results update live</p>
      <%= turbo_stream_from PollVote::STREAM %>
      <%= render "poll_votes/results", tally: @poll_tally %>
      <dl class="admin-dashboard__grid">
        <div class="admin-dashboard__metric">
          <dt>votes in the last 24 hours</dt>
          <dd><%= number_with_delimiter(@poll_recent_votes) %></dd>
        </div>
        <div class="admin-dashboard__metric">
          <dt>dismissed without voting</dt>
          <dd><%= number_with_delimiter(@poll_dismissed_without_voting) %></dd>
        </div>
      </dl>
      <p class="admin-dashboard__metric-note">24-hour votes and dismissals update on refresh · dismissals exclude accounts that have since voted</p>
      <%= link_to "open live poll results", admin_poll_results_path %>
    </section>
  <% end %>

  <section aria-labelledby="buku-discoveries-heading">
    <h2 id="buku-discoveries-heading">roles discovered</h2>
    <p class="admin-dashboard__metric-note">unique accounts that completed their role reveal · previews don't count · updates on refresh</p>
    <dl class="admin-dashboard__grid">
      <div class="admin-dashboard__metric">
        <dt>total discovered</dt>
        <dd><%= number_with_delimiter(@buku_discoveries[:total]) %></dd>
      </div>
      <div class="admin-dashboard__metric admin-dashboard__metric--buku">
        <dt>buku bukus</dt>
        <dd><%= number_with_delimiter(@buku_discoveries[:buku]) %></dd>
      </div>
      <div class="admin-dashboard__metric admin-dashboard__metric--bean">
        <dt>beans</dt>
        <dd><%= number_with_delimiter(@buku_discoveries[:bean]) %></dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="crescent-clicks-heading">
    <h2 id="crescent-clicks-heading">crescent ad clicks</h2>
    <% if @crescent_clicks %>
      <p class="admin-dashboard__metric-note">"onwards!" on the discover rail's crescent ad · all time · updates on refresh</p>
      <dl class="admin-dashboard__grid">
        <div class="admin-dashboard__metric">
          <dt>clicks</dt>
          <dd><%= number_with_delimiter(@crescent_clicks[:total]) %></dd>
        </div>
        <div class="admin-dashboard__metric">
          <dt>people who clicked</dt>
          <dd><%= number_with_delimiter(@crescent_clicks[:people]) %></dd>
        </div>
      </dl>
    <% else %>
      <p class="admin-dashboard__metric-note">click tracking is off here: AHOY_DB_URL isn't set, so no events are stored</p>
    <% end %>
  </section>

  <section aria-labelledby="mipmap-clicks-heading">
    <h2 id="mipmap-clicks-heading">mipmap ad clicks</h2>
    <% if @mipmap_clicks %>
      <p class="admin-dashboard__metric-note">the discover rail's mipmap ad · all time · updates on refresh</p>
      <dl class="admin-dashboard__grid">
        <div class="admin-dashboard__metric">
          <dt>clicks</dt>
          <dd><%= number_with_delimiter(@mipmap_clicks[:total]) %></dd>
        </div>
        <div class="admin-dashboard__metric">
          <dt>people who clicked</dt>
          <dd><%= number_with_delimiter(@mipmap_clicks[:people]) %></dd>
        </div>
      </dl>
    <% else %>
      <p class="admin-dashboard__metric-note">click tracking is off here: AHOY_DB_URL isn't set, so no events are stored</p>
    <% end %>
  </section>

  <section aria-labelledby="day-one-of-clicks-heading">
    <h2 id="day-one-of-clicks-heading">day one of ad clicks</h2>
    <% if @day_one_of_clicks %>
      <p class="admin-dashboard__metric-note">"start day one" on the discover rail's day one of ad · all time · updates on refresh</p>
      <dl class="admin-dashboard__grid">
        <div class="admin-dashboard__metric">
          <dt>clicks</dt>
          <dd><%= number_with_delimiter(@day_one_of_clicks[:total]) %></dd>
        </div>
        <div class="admin-dashboard__metric">
          <dt>people who clicked</dt>
          <dd><%= number_with_delimiter(@day_one_of_clicks[:people]) %></dd>
        </div>
      </dl>
    <% else %>
      <p class="admin-dashboard__metric-note">click tracking is off here: AHOY_DB_URL isn't set, so no events are stored</p>
    <% end %>
  </section>

  <section aria-labelledby="torque-clicks-heading">
    <h2 id="torque-clicks-heading">torque ad clicks</h2>
    <% if @torque_clicks %>
      <p class="admin-dashboard__metric-note">clicks on the discover rail's torque ad · all time · updates on refresh</p>
      <dl class="admin-dashboard__grid">
        <div class="admin-dashboard__metric">
          <dt>clicks</dt>
          <dd><%= number_with_delimiter(@torque_clicks[:total]) %></dd>
        </div>
        <div class="admin-dashboard__metric">
          <dt>people who clicked</dt>
          <dd><%= number_with_delimiter(@torque_clicks[:people]) %></dd>
        </div>
      </dl>
    <% else %>
      <p class="admin-dashboard__metric-note">click tracking is off here: AHOY_DB_URL isn't set, so no events are stored</p>
    <% end %>
  </section>

  <section aria-labelledby="buku-shippers-heading"
           data-controller="buku-activity-chart"
           data-buku-activity-chart-data-value="<%= @buku_daily_shippers.to_json %>">
    <h2 id="buku-shippers-heading">daily active shippers</h2>
    <p class="admin-dashboard__metric-note">last 14 days · eastern time · unique users with approved event hours, grouped by ship date · late approvals update earlier days</p>
    <div class="admin-dashboard__activity-chart">
      <canvas data-buku-activity-chart-target="canvas" role="img" aria-label="daily active shippers: stacked bars for buku bukus and beans">
        <% @buku_daily_shippers.each do |day| %>
          <%= day[:date].iso8601 %>: <%= day[:buku] %> buku bukus, <%= day[:bean] %> beans;
        <% end %>
      </canvas>
    </div>
    <% if @buku_daily_shippers.all? { |day| day[:buku].zero? && day[:bean].zero? } %>
      <p class="admin-dashboard__metric-note">no approved event ships in this period yet</p>
    <% end %>
  </section>

  <% if policy(:admin).manage_buku_event? %>
    <section aria-labelledby="bukux2-export-heading">
      <h2 id="bukux2-export-heading">bukux2 contributors</h2>
      <p class="admin-dashboard__metric-note">ships from september 3–24, 2026 inclusive · eastern time · users with positive net approved hours under bukux2 rules</p>
      <p class="admin-dashboard__metric-note">uses current approvals and fraud deductions, including late approvals · one row per user with username, slack id, counted ships, and approved hours</p>
      <%= button_to "download bukux2 contributors csv", admin_bukux2_contributors_export_path,
                    method: :post, class: "btn-primary", form: { data: { turbo: false } } %>
      <%= link_to "view export audit history", admin_audit_logs_path(event: "export_bukux2_contributors") %>
    </section>

    <section class="admin-dashboard__event-controls" aria-labelledby="buku-intensity-heading">
      <h2 id="buku-intensity-heading">disintegration intensity</h2>
      <p>visual effect only · does not change team hours or the tug-of-war score</p>
      <p class="admin-dashboard__metric-note" id="buku-intensity-help">0% turns it off · 100% is normal · 200% doubles the effect, capped at full disintegration · live pages update within a minute</p>
      <%= form_with scope: :buku_x3_event, url: admin_buku_x3_event_path, method: :patch, class: "admin-dashboard__intensity-form" do |f| %>
        <%= f.label :visual_intensity, "visual intensity (%)" %>
        <%= f.number_field :visual_intensity, value: @buku_event.visual_intensity, min: 0, max: 200, step: 1, required: true,
                           class: "admin-filters__input", aria: { describedby: "buku-intensity-help" } %>
        <%= f.submit "save intensity", class: "btn-primary" %>
      <% end %>
      <%= link_to "view intensity audit history", admin_audit_logs_path(item_type: "BukuX3::Event", changed_field: "visual_intensity") %>
    </section>
  <% end %>
</div>
