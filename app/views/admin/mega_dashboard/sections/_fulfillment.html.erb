<%= turbo_frame_tag "mega-dash-fulfillment", target: "_top" do %>
  <section class="mega-dash__section" aria-labelledby="mega-dash-lettermail-title">
    <div class="mega-dash__section-heading">
      <h2 id="mega-dash-lettermail-title">Lettermail</h2>
      <span class="mega-dash__note">Includes free stickers and streak stickers</span>
    </div>

    <%= render "admin/mega_dashboard/sections/fulfillment_table", groups: @fulfillment[:lettermail_groups] %>
  </section>

  <section class="mega-dash__section" aria-labelledby="mega-dash-fulfillment-title">
    <div class="mega-dash__section-heading">
      <h2 id="mega-dash-fulfillment-title">Fulfillment</h2>
      <span class="mega-dash__note">Everything except lettermail</span>
    </div>

    <% if @fulfillment[:stale_warehouse].positive? %>
      <p class="mega-dash__note">
        <%= pluralize(@fulfillment[:stale_warehouse], "warehouse order") %>
        have been awaiting fulfillment for more than <%= pluralize(@fulfillment[:stale_days], "day") %>.
      </p>
    <% end %>

    <%= render "admin/mega_dashboard/sections/fulfillment_table", groups: @fulfillment[:groups] %>

    <% if @fulfillment[:recent_items].any? %>
      <div class="mega-dash__attention">
        <h3>Recently added items</h3>
        <div class="mega-dash__meta">
          <% @fulfillment[:recent_items].each do |name| %>
            <span><%= name %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
