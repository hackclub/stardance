<%= turbo_frame_tag "mega-dash-fulfillment", target: "_top" do %>
  <section class="mega-dash__section" aria-labelledby="mega-dash-fulfillment-title">
    <div class="mega-dash__section-heading">
      <h2 id="mega-dash-fulfillment-title">Fulfillment mix</h2>
      <span class="mega-dash__note">Free stickers and streak stickers excluded</span>
    </div>

    <% if @fulfillment[:stale_warehouse].positive? %>
      <p class="mega-dash__note">
        <%= pluralize(@fulfillment[:stale_warehouse], "warehouse order") %>
        have been awaiting fulfillment for more than <%= pluralize(@fulfillment[:stale_days], "day") %>.
      </p>
    <% end %>

    <div class="mega-dash__table-scroll">
      <table class="mega-dash__table">
        <thead>
          <tr>
            <th scope="col">Group</th>
            <th scope="col">Awaiting</th>
            <th scope="col">Fulfilled</th>
          </tr>
        </thead>
        <tbody>
          <% @fulfillment[:groups].each do |group| %>
            <tr>
              <th scope="row"><%= group[:label] %></th>
              <td><%= number_with_delimiter(group[:awaiting]) %></td>
              <td><%= number_with_delimiter(group[:fulfilled]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @fulfillment[:recent_items].any? %>
      <div class="mega-dash__attention">
        <h3>Recently added items</h3>
        <div class="mega-dash__meta">
          <% @fulfillment[:recent_items].each do |name| %>
            <span><%= name %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
<% end %>
