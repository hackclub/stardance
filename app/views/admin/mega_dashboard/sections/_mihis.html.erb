<%= turbo_frame_tag "mega-dash-mihis", target: "_top" do %>
  <section class="mega-dash__section mega-dash__panel" aria-labelledby="mega-dash-mihis-title">
    <div class="mega-dash__section-heading">
      <h2 id="mega-dash-mihis-title">Daily active mihis (DAMs)</h2>
      <span class="mega-dash__note">Unique people who clicked the mihi button each day · Eastern time</span>
    </div>
    <div class="mega-dash__tiles">
      <%= render "admin/mega_dashboard/tile", label: "DAMs today", value: @mihis[:today], note: "Each person counts once per day" %>
      <%= render "admin/mega_dashboard/tile", label: "Unique mihis", value: @mihis[:unique_users], note: "Over the last #{@period} days" %>
      <%= render "admin/mega_dashboard/tile", label: "Total mihis", value: @mihis[:total], note: "All activations over the last #{@period} days" %>
    </div>
    <%= line_chart [{ name: "DAMs", data: @mihis[:daily] }, { name: "Total mihis", data: @mihis[:daily_totals] }], id: "daily-active-mihis-chart", min: 0, discrete: true, xtitle: "Day (Eastern)", ytitle: "Mihis", colors: ["#81FFFF", "#EBB7FF"], library: { plugins: { legend: { labels: { color: "#FFF8D5" } } }, scales: { x: { ticks: { color: "#FFF8D5" }, title: { color: "#FFF8D5" } }, y: { ticks: { precision: 0, color: "#FFF8D5" }, title: { color: "#FFF8D5" } } } } %>
    <%= link_to "View activation audit log", admin_audit_logs_path(item_type: "MihiActivation") %>
  </section>
<% end %>
