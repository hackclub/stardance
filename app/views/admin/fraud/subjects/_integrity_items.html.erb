<%= turbo_frame_tag "fraud-subject-integrity-items" do %>
  <% checks = local_assigns.fetch(:checks) { Admin::Fraud::SubjectQueue.integrity_checks_for(user) }.load %>

  <%# The heading sits inside the frame so its count is re-rendered with the
      list a verdict replaces, rather than going stale above it. %>
  <h2 class="fraud-subject__section-title" id="fraud-subject-integrity">
    Integrity checks
    <span class="fraud-subject__section-count"><%= checks.size %></span>
  </h2>

  <% if checks.any? %>
    <% if Admin::Certification::IntegrityPolicy.new(current_user, :integrity).update? %>
      <div class="fraud-subject__bulk-actions" aria-label="Bulk integrity actions">
        <%= button_to "Pass all #{pluralize(checks.size, "check")}",
                      admin_certification_pass_all_integrity_reviews_path,
                      params: { check_ids: checks.map(&:id), fraud_subject_id: user.id },
                      class: "fraud-subject__verdict fraud-subject__verdict--accept",
                      data: { turbo_confirm: "Pass all #{checks.size} integrity checks for #{user.display_name}?" } %>
      </div>
    <% end %>

    <div class="fraud-subject__items">
      <%= render partial: "admin/fraud/subjects/integrity_check", collection: checks, as: :check, locals: { user: user } %>
    </div>
  <% else %>
    <p class="fraud-subject__empty">No integrity checks waiting.</p>
  <% end %>
<% end %>
