<% content_for :title, "Virality reviews" %>
<div class="app-layout app-layout--wide">
  <section class="app-layout__main app-layout__main--wide virality-review" data-controller="hotkeys" data-action="keydown@document->hotkeys#press">
    <header class="virality-review__top">
      <h1>Virality reviews</h1>
      <p class="virality-review__legend" aria-label="Keyboard shortcuts">
        <span><kbd>J</kbd><kbd>K</kbd> next / previous project</span>
        <span><kbd>/</kbd> search</span>
        <span><kbd>O</kbd> open first link</span>
        <span><kbd>E</kbd> checklist</span>
        <span><kbd>N</kbd> note</span>
        <span><kbd>A</kbd><kbd>R</kbd><kbd>H</kbd> approve / reject / hold selected</span>
        <span><kbd>Esc</kbd> leave field</span>
      </p>
    </header>
    <% @undoable.each do |decision| %>
      <div class="virality-review__undo" data-controller="virality-review"
        data-virality-review-deadline-value="<%= decision.process_at.iso8601 %>"
        data-virality-review-server-time-value="<%= Time.current.iso8601 %>">
        <span>
          <strong><%= decision.action.humanize %><%= " #{decision.tier.capitalize}" if decision.action == "approve" %></strong>
          · <%= link_to decision.project_mention.project.title, admin_virality_reviews_path(queue: "scheduled", mention_id: decision.project_mention_id) %>
          · <span class="virality-review__countdown" data-virality-review-target="countdown"></span>
        </span>
        <%= button_to "Stop", cancel_admin_virality_review_path(decision), class: "virality-review__button virality-review__button--danger" %>
      </div>
    <% end %>
    <nav class="virality-review__tabs" aria-label="Review queues">
      <% Admin::ViralityReviewsController::QUEUES.each do |queue, label| %>
        <%= link_to admin_virality_reviews_path(queue: queue), class: "virality-review__tab", aria: { current: (@queue == queue ? "page" : nil) } do %>
          <%= label %> <span><%= @counts[queue] %></span>
        <% end %>
      <% end %>
    </nav>
    <% if @queue == "reviewed" && @awaiting_confirmation.positive? %>
      <p class="virality-review__muted"><%= pluralize(@awaiting_confirmation, "imported verdict") %> awaiting confirmation. Nothing is applied or paid until a reviewer confirms.</p>
    <% end %>
    <div class="virality-review__layout">
      <aside class="virality-review__queue" aria-label="Projects">
        <%= form_with url: admin_virality_reviews_path, method: :get, class: "virality-review__search", data: { turbo_action: "replace" } do %>
          <%= hidden_field_tag :queue, @queue, id: nil %>
          <%= search_field_tag :q, @search, placeholder: "Search projects, links, notes", autocomplete: "off", aria: { label: "Search projects" }, data: { hotkey: "/" } %>
          <%= select_tag :sort, options_for_select(Admin::ViralityReviewsController::SORTS.invert, @sort), aria: { label: "Sort" }, onchange: "this.form.requestSubmit()" %>
        <% end %>
        <% current_project = (@review || @mention)&.project %>
        <% current_index = @reviews.index { |review| review.project == current_project } || -1 %>
        <% @reviews.each_with_index do |review, index| %>
          <%= link_to admin_virality_reviews_path(queue: @queue, project_id: review.project.id, q: @search.presence, sort: @sort, page: params[:page]), class: "virality-review__item",
                aria: { current: (review.project == current_project ? "true" : nil) }, data: { hotkey: { current_index + 1 => "j", current_index - 1 => "k" }[index] } do %>
            <strong><%= review.project.title %></strong>
            <span><%= pluralize(review.groups.size, "link") %> · <%= pluralize(review.mentions.size, "mention") %><% if review.oldest_pending_at %> · <%= time_ago_in_words(review.oldest_pending_at) %> old<% end %></span>
            <span class="virality-review__item-states">
              <% Virality::ProjectReview::STATES.each do |state, label| %>
                <% if (count = review.counts[state]) %><span class="virality-review__tag virality-review__tag--<%= state.dasherize %>"><%= count %> <%= label.downcase %></span><% end %>
              <% end %>
            </span>
            <% if review.red_flags.positive? %><span class="virality-review__item-flags"><%= pluralize(review.red_flags, "red flag") %></span><% end %>
          <% end %>
        <% end %>
        <% if @reviews.empty? %><p class="virality-review__muted"><%= @search.present? ? "Nothing matches “#{@search}”." : "Nothing in this queue." %></p><% end %>
        <%== @pagy.series_nav if @pagy.pages > 1 %>
      </aside>
      <div class="virality-review__detail">
        <% if @mention %>
          <%= link_to "← All mentions for #{@mention.project.title}", admin_virality_reviews_path(queue: @queue, project_id: @mention.project_id), class: "virality-review__back" %>
          <%= render "detail" %>
        <% elsif @review %>
          <%= render "project" %>
        <% else %>
          <p class="virality-review__muted">Choose another queue to continue.</p>
        <% end %>
      </div>
    </div>
  </section>
</div>
