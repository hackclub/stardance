<% if grouped_orders.empty? %>
  <p class="admin-users__empty">No orders found matching the filters.</p>
<% end %>

<% grouped_orders.each do |group| %>
  <div class="shop-orders__group">
    <div class="shop-orders__group-header">
      <h3 class="shop-orders__group-name">
        <%= link_to group[:user].display_name || "Unknown", admin_user_path(group[:user]) %>
      </h3>
      <div class="shop-orders__group-email">
        <%= group[:user].email %>
      </div>
      <div class="shop-orders__group-meta">
        <span><%= pluralize(group[:orders].count, 'order') %></span>
        <span><%= pluralize(group[:total_items], 'item') %></span>
        <span><%= group[:total_shells] %> tickets</span>
      </div>
      <% approvable_orders = group[:orders].select { |order| approvable_order?(order) } %>
      <% if approvable_orders.size > 1 %>
        <%= render "approve_all", user: group[:user], orders: approvable_orders %>
      <% end %>
    </div>

    <div>
    <table class="space-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Item</th>
          <th>Qty</th>
          <th>Tickets</th>
          <th>Status</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% group[:orders].each do |order| %>
          <tr>
            <td>#<%= order.id %></td>
            <td>
              <%= order.shop_item.name %><br>
              <small><%= order.shop_item.type&.demodulize %></small>
              <% if order.mission_submission.present? %>
                <br><span class="shop-orders__mission-badge" title="Redeemed for free via the &quot;<%= order.mission_submission.mission.name %>&quot; mission">🎖️ Free via mission</span>
              <% end %>
            </td>
            <td><%= order.quantity %></td>
            <td><%= order.total_cost %></td>
            <td>
              <span class="badge badge-<%= order.aasm_state %>">
                <%= order.aasm_state.humanize %>
              </span>
              <%= render "admin/shop/orders/hold_countdown", order: order %>
            </td>
            <td><%= order.created_at.strftime("%b %d, %Y") %></td>
            <td>
              <div class="shop-orders__row-actions">
                <%= link_to "Inspect", admin_shop_order_path(order, return_view: params[:view], return_status: params[:status]) %>
                <%= render "approve_button", order: order %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
<% end %>
