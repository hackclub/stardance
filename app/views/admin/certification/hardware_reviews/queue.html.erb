<% design = @stage == "design" %>
<% content_for :title, hardware_queue_title(design) %>

<%
  status_labels = { "pending" => "Pending", "approved" => "Approved", "returned" => "Returned", "all" => "All" }
  net_today = @stats[:decisions_today] - @stats[:new_today]
  oldest = @stats[:oldest_pending]
  oldest_days = oldest ? ((Time.current - oldest[:submitted_at]) / 1.day).floor : nil
%>

<div class="app-layout app-layout--wide"
     data-controller="certification--queue"
     data-certification--queue-server-now-value="<%= Time.current.iso8601 %>">
  <div class="app-layout__main app-layout__main--wide ship-queue hardware-queue">
    <%= link_to hardware_back_link[:label], hardware_back_link[:path], class: "ship-queue__back" %>

    <header class="ship-queue__header">
      <div class="ship-queue__title">
        <h1><%= hardware_queue_title(design) %></h1>
        <span class="hardware-queue__subtitle">
          <%= design ? "Funding requests waiting on a grant decision" : "Finished builds waiting on certification" %>
        </span>
      </div>
      <div class="ship-queue__header-actions">
        <button type="button" class="action-btn action-btn--large action-btn--secondary"
                onclick="document.getElementById('hardware-my-stats').showModal()">
          My Stats
        </button>
        <%= link_to "Start reviewing", hardware_next_path(stage: @stage),
              class: "action-btn action-btn--large action-btn--primary" %>
      </div>
    </header>

    <%# The two queues are separate jobs; this is the only place they meet. %>
    <nav class="hardware-queue__stages" aria-label="Review queues">
      <%= link_to hardware_queue_path("design"),
            class: class_names("hardware-queue__stage", "is-active" => design),
            aria: { current: (design ? "page" : nil) } do %>
        <span class="hardware-queue__stage-name">Design</span>
        <span class="hardware-queue__stage-count"><%= @tab_counts["design"] %></span>
      <% end %>
      <%= link_to hardware_queue_path("build"),
            class: class_names("hardware-queue__stage", "is-active" => !design),
            aria: { current: (design ? nil : "page") } do %>
        <span class="hardware-queue__stage-name">Build</span>
        <span class="hardware-queue__stage-count"><%= @tab_counts["build"] %></span>
      <% end %>
    </nav>

    <%# Only what a reviewer can act on: how much is waiting, how stale the worst
        of it is, and whether today is keeping pace with intake. %>
    <section class="hardware-queue__vitals">
      <div class="hardware-queue__vital hardware-queue__vital--primary">
        <span class="hardware-queue__vital-value"><%= @stats[:pending] %></span>
        <span class="hardware-queue__vital-label">waiting for review</span>
      </div>

      <div class="hardware-queue__vital">
        <% if oldest %>
          <%= link_to hardware_review_path(oldest[:project]),
                class: class_names("hardware-queue__vital-value", "hardware-queue__vital-value--link" => true,
                                   "is-negative" => oldest_days >= @stats[:sla_days]) do %>
            <%= oldest_days %>d
          <% end %>
          <span class="hardware-queue__vital-label">oldest wait</span>
        <% else %>
          <span class="hardware-queue__vital-value">—</span>
          <span class="hardware-queue__vital-label">queue clear</span>
        <% end %>
      </div>

      <div class="hardware-queue__vital">
        <span class="hardware-queue__vital-value <%= @stats[:overdue_pending].positive? ? "is-negative" : "is-positive" %>">
          <%= @stats[:overdue_pending] %>
        </span>
        <span class="hardware-queue__vital-label">past <%= @stats[:sla_days] %>-day target</span>
      </div>

      <div class="hardware-queue__vital">
        <span class="hardware-queue__vital-value <%= net_today >= 0 ? "is-positive" : "is-negative" %>">
          <%= net_today >= 0 ? "+" : "" %><%= net_today %>
        </span>
        <span class="hardware-queue__vital-label">
          today · <%= @stats[:decisions_today] %> done, <%= @stats[:new_today] %> in
        </span>
      </div>
    </section>

    <%= form_with url: hardware_queue_path(@stage), method: :get,
          data: { certification__queue_target: "filters" }, class: "ship-queue__filters" do %>
      <div class="ship-queue__filter">
        <label for="filter-status">Status</label>
        <%= select_tag :status,
              options_for_select(status_labels.map { |value, label| [ label, value ] }, @status),
              id: "filter-status", class: "ship-queue__select",
              data: { action: "change->certification--queue#submit" } %>
      </div>
      <div class="ship-queue__filter">
        <label for="filter-sort">Sort</label>
        <%= select_tag :sort,
              options_for_select([ [ "Oldest first", "oldest" ], [ "Newest first", "newest" ] ], @sort),
              id: "filter-sort", class: "ship-queue__select",
              data: { action: "change->certification--queue#submit" } %>
      </div>
      <div class="ship-queue__filter ship-queue__filter--search">
        <label for="filter-search">Search</label>
        <%= text_field_tag :search, @search, id: "filter-search", placeholder: "review id or project title",
              class: "ship-queue__input", autocomplete: "off" %>
      </div>
      <%# Date range is an audit tool rather than part of working the queue, so
          it stays available but folded away. %>
      <details class="hardware-queue__dates" <%= "open" if @from || @to %>>
        <summary>Date range</summary>
        <div class="hardware-queue__dates-fields">
          <%= date_field_tag :from, @from&.iso8601, class: "ship-queue__input", autocomplete: "off",
                aria: { label: "From" }, data: { action: "change->certification--queue#submit" } %>
          <%= date_field_tag :to, @to&.iso8601, class: "ship-queue__input", autocomplete: "off",
                aria: { label: "To" }, data: { action: "change->certification--queue#submit" } %>
        </div>
      </details>
      <div class="ship-queue__filter-actions">
        <button type="submit" class="action-btn action-btn--small action-btn--secondary">Apply</button>
        <%= link_to "Reset", hardware_queue_path(@stage), class: "ship-queue__reset" %>
      </div>
    <% end %>

    <% if @review_items.empty? %>
      <div class="ship-queue__empty">
        <p><%= @status == "pending" ? "Nothing waiting in the #{@stage} queue." : "Nothing matches these filters." %></p>
      </div>
    <% else %>
      <div class="ship-queue__table-wrap">
        <table class="ship-queue__table">
          <thead>
            <tr>
              <th>Project</th>
              <th>Submitter</th>
              <th><%= design ? "Requested" : "Build" %></th>
              <th class="ship-queue__cell-wait">Wait</th>
              <th class="ship-queue__cell-status">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @review_items.each do |item| %>
              <% wait_days = ((Time.current - item[:submitted_at]) / 1.day).floor %>
              <tr class="ship-queue__row ship-queue__row--anchored">
                <td class="ship-queue__cell-project">
                  <div class="ship-queue__project-head">
                    <%= link_to item[:project].title, hardware_review_path(item[:project]),
                          class: "ship-queue__project-title ship-queue__row-link" %>
                    <span class="ship-queue__project-id">#<%= item[:project].id %></span>
                    <%= render "admin/certification/hardware_reviews/hackpad_tag", project: item[:project], hackpad_project_ids: @hackpad_project_ids %>
                  </div>
                  <div class="ship-queue__project-meta">
                    <% if design %>
                      <%= render "admin/certification/funding_requests/claim_flag", funding_request: item[:record] %>
                    <% else %>
                      <%= render "admin/certification/ships/claim_flag", ship: item[:record] %>
                    <% end %>
                  </div>
                </td>
                <td><%= item[:owner]&.display_name || "—" %></td>
                <td class="hardware-queue__cell-ask">
                  <%= render "admin/certification/hardware_reviews/queue_ask", item: item, design: design %>
                </td>
                <td class="ship-queue__cell-wait">
                  <span class="ship-queue__wait-badge <%= "is-negative" if wait_days >= @stats[:sla_days] %>"><%= wait_days %>d</span>
                </td>
                <td class="ship-queue__cell-status">
                  <span class="status-pill status-pill--<%= item[:record].status %>"><%= item[:record].status.capitalize %></span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="ship-queue__cards">
        <% @review_items.each do |item| %>
          <% wait_days = ((Time.current - item[:submitted_at]) / 1.day).floor %>
          <%= link_to hardware_review_path(item[:project]), class: "ship-queue__card" do %>
            <div class="ship-queue__card-top">
              <span class="ship-queue__project-title">
                <%= item[:project].title %>
                <%= render "admin/certification/hardware_reviews/hackpad_tag", project: item[:project], hackpad_project_ids: @hackpad_project_ids %>
              </span>
              <span class="status-pill status-pill--<%= item[:record].status %>"><%= item[:record].status.capitalize %></span>
            </div>
            <div class="ship-queue__project-meta">
              <%= render "admin/certification/hardware_reviews/queue_ask", item: item, design: design %>
              <span class="ship-queue__dot" aria-hidden="true">·</span>
              <span>by <%= item[:owner]&.display_name || "—" %></span>
              <span class="ship-queue__dot" aria-hidden="true">·</span>
              <span class="ship-queue__wait-badge <%= "is-negative" if wait_days >= @stats[:sla_days] %>"><%= wait_days %>d</span>
            </div>
          <% end %>
        <% end %>
      </div>

      <%== @pagy.series_nav %>
    <% end %>

    <%# Reviewer counts feed the payout process, so they stay - just below the
        work rather than competing with it. %>
    <section class="ship-queue__leaderboard hardware-queue__leaderboard">
      <div class="ship-queue__leaderboard-head">
        <h2>Reviewer leaderboard</h2>
        <div class="ship-queue__tabs">
          <% %w[daily weekly alltime].each do |period| %>
            <%= link_to(period == "alltime" ? "All time" : period.capitalize,
                  hardware_queue_path(@stage, **params.permit(:status, :sort, :search, :from, :to).to_h.symbolize_keys.merge(lb: period)),
                  class: class_names("ship-queue__tab", "is-active" => period == @lb_period)) %>
          <% end %>
        </div>
      </div>

      <ol class="ship-queue__ranks">
        <% if @leaderboard.empty? %>
          <li class="ship-queue__ranks-empty">No reviews yet.</li>
        <% else %>
          <% @leaderboard.each_with_index do |row, i| %>
            <li class="ship-queue__rank">
              <span class="ship-queue__rank-pos"><%= i + 1 %></span>
              <span class="ship-queue__rank-name"><%= row[:name] %></span>
              <span class="ship-queue__rank-count"><%= row[:count] %></span>
            </li>
          <% end %>
        <% end %>
      </ol>
    </section>

    <%= render "admin/certification/hardware_reviews/my_stats_modal", stats: @my_stats %>
  </div>
</div>
