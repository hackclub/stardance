<%
  # Impact first, then momentum, then where you sit in the crew this week. Each
  # tile is { value:, label:, note: } so the grid stays one loop.
  best_day = progress[:best_day]
  rank     = progress[:rank]
  payout   = progress[:weekly_payout]

  devlog_pace  = progress[:pace]
  project_pace = progress[:project_pace]
  devlog_goal  = ::Certification::Ysws::DEVLOG_REVIEW_GOAL_PER_DAY
  project_goal = ::Certification::Ysws::PROJECT_REVIEW_GOAL_PER_DAY

  # Short of both goals, point at the nearer one rather than listing both — one
  # number to chase reads as a target, two read as a scolding.
  nearer_count, nearer_unit =
    if devlog_pace[:needed_today] <= project_pace[:needed_today]
      [ devlog_pace[:needed_today], "more devlog" ]
    else
      [ project_pace[:needed_today], "more project" ]
    end

  earned_amount = number_with_precision(payout[:earned], precision: 2, strip_insignificant_zeros: true)
  goal_amount   = number_with_precision(payout[:goal_payout], precision: 2, strip_insignificant_zeros: true)
  weekly_goal   = number_with_delimiter(::Certification::Ysws::WEEKLY_DEVLOG_GOAL)

  # Short of the goal, the gap is the story; past it, the rate is — every extra
  # devlog still pays. One clause either way, so the payout stays a sentence.
  # "more" is invariant, so it's never passed through `pluralize` — that would
  # read "118 mores".
  goal_note =
    if payout[:devlogs_to_goal].positive?
      "#{number_with_delimiter payout[:devlogs_to_goal]} more to lock in your " \
      "week at #{goal_amount} ✦."
    elsif payout[:devlogs_past_goal].positive?
      "That's #{number_with_delimiter payout[:devlogs_past_goal]} past the " \
      "#{weekly_goal}-devlog goal, and every extra one still pays #{payout[:rate]} ✦."
    else
      "That's the #{weekly_goal}-devlog goal met exactly — every devlog from " \
      "here still pays #{payout[:rate]} ✦."
    end

  stats = [
    { value: number_with_delimiter(progress[:hours_certified]),
      label: "Hours certified",
      note: "of building, signed off by you" },
    { value: number_with_delimiter(progress[:people_reviewed]),
      label: "People reviewed",
      note: "different people, all time" },
    { value: progress[:projects_today],
      label: "Projects today",
      note: "since 4pm ET — #{project_goal}/day locks you in" },
    { value: progress[:best_day_devlogs] || 0,
      label: "Best day",
      note: best_day ? "your record, set #{best_day.strftime('%-m/%-d')}" : "no reviews yet" },
    { value: "#{number_with_precision(progress[:share_of_week], precision: 0)}%",
      label: "Share this week",
      note: "of every devlog the crew reviewed" },
    { value: rank ? "##{rank}" : "—",
      label: "Rank this week",
      note: rank ? "of #{pluralize(progress[:crew_size], 'reviewer')}" : "review one to get ranked" }
  ]
%>

<section class="ysws-dashboard__progress" aria-labelledby="ysws-progress-heading">
  <h3 class="ysws-dashboard__heading" id="ysws-progress-heading">See your progress</h3>

  <%= tag.div class: [ "ysws-dashboard__progress-hero", ("ysws-dashboard__progress-hero--locked-in" if progress[:locked_in]) ],
              role: "status", aria: { live: "polite" } do %>
    <%# Both paths to locked in, side by side — holding either one is enough. %>
    <div class="ysws-dashboard__progress-paces">
      <p class="ysws-dashboard__progress-primary">
        <span class="ysws-dashboard__progress-count">
          <%= number_with_precision devlog_pace[:daily_average], precision: 1, strip_insignificant_zeros: true %>
        </span>
        <span class="ysws-dashboard__progress-label">devlogs / day this week</span>
      </p>

      <p class="ysws-dashboard__progress-primary">
        <span class="ysws-dashboard__progress-count">
          <%= number_with_precision project_pace[:daily_average], precision: 1, strip_insignificant_zeros: true %>
        </span>
        <span class="ysws-dashboard__progress-label">projects / day this week</span>
      </p>
    </div>

    <p class="ysws-dashboard__progress-note">
      <% if devlog_pace[:needed_today].zero? %>
        Locked in — <%= devlog_goal %> devlogs/day average met
      <% elsif project_pace[:needed_today].zero? %>
        Locked in — <%= project_goal %> projects/day average met
      <% else %>
        <%= pluralize nearer_count, nearer_unit %> today to lock in!
      <% end %>
    </p>
  <% end %>

  <% if payout[:devlogs].zero? %>
    <p class="ysws-dashboard__progress-payout">
      Nothing earned yet this week — review <%= weekly_goal %> devlogs for
      <strong class="ysws-dashboard__progress-payout-amount"><%= goal_amount %> ✦</strong>.
    </p>
  <% else %>
    <p class="ysws-dashboard__progress-payout">
      <strong class="ysws-dashboard__progress-payout-amount"><%= earned_amount %> ✦</strong>
      earned this week — from the
      <%= pluralize number_with_delimiter(payout[:devlogs]), "devlog" %> you've
      reviewed. <%= goal_note %>
    </p>
  <% end %>

  <dl class="ysws-dashboard__progress-stats">
    <% stats.each do |stat| %>
      <div class="ysws-dashboard__progress-stat">
        <dt class="ysws-dashboard__progress-stat-label"><%= stat[:label] %></dt>
        <dd class="ysws-dashboard__progress-stat-value"><%= stat[:value] %></dd>
        <dd class="ysws-dashboard__progress-stat-note"><%= stat[:note] %></dd>
      </div>
    <% end %>
  </dl>

  <% if (tier = progress[:next_tier]) %>
    <div class="ysws-dashboard__progress-tier">
      <p class="ysws-dashboard__progress-tier-note">
        <strong><%= number_with_delimiter progress[:lifetime_devlogs] %></strong> devlogs reviewed, all time —
        <%= number_with_delimiter tier[:devlogs_needed] %> more
        to earn <%= tier[:rate] %> ✦ each, up from <%= tier[:current_rate] %> ✦.
      </p>
      <div class="ysws-dashboard__progress-tier-track" style="--tier-fill: <%= tier[:percent] %>%"
           role="progressbar" aria-valuenow="<%= tier[:percent] %>" aria-valuemin="0" aria-valuemax="100"
           aria-label="Progress to the next stardust rate">
        <div class="ysws-dashboard__progress-tier-fill"></div>
      </div>
    </div>
  <% else %>
    <p class="ysws-dashboard__progress-tier-note">
      <strong><%= number_with_delimiter progress[:lifetime_devlogs] %></strong> devlogs reviewed, all time —
      you're on the top stardust rate.
    </p>
  <% end %>
</section>
