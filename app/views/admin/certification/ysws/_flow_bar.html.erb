<%# Sticky controls for the faster YSWS review flow. Flow state is just
    params[:flow], so leaving the flow is a regular link back to the queue.

    Locals:
      review — the Certification::Ysws currently on screen. %>
<% if @flow_mode %>
  <nav class="ysws-flow-bar" aria-label="Review session">
    <div class="ysws-flow-bar__group">
      <span class="ysws-flow-bar__label">Faster review mode</span>
      <span class="ysws-flow-bar__count" aria-label="Project <%= flow_step %> of <%= flow_step_limit %> in this flow">
        Project <%= flow_step %>/<%= flow_step_limit %>
      </span>
    </div>

    <div class="ysws-flow-bar__group">
      <% if review.pending? && review.claimed_by?(current_user) %>
        <%= button_to "Skip", skip_admin_certification_ysws_review_path(review),
                      method: :post,
                      params: flow_params,
                      class: "ysws-flow-bar__btn",
                      form_class: "ysws-flow-bar__form",
                      form: { data: { turbo: false } } %>
      <% end %>

      <%= link_to "End flow",
                  admin_certification_ysws_reviews_path,
                  class: "ysws-flow-bar__btn ysws-flow-bar__btn--end" %>
    </div>
  </nav>
<% end %>
