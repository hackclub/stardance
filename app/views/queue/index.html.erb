<% content_for :title, "Order queue" %>

<div class="container queue">
  <%= render HeadingComponent.new(title: "Order queue", tone: :blue, size: :full) %>

  <p class="queue__intro">
    Every shop order is checked by a human before it ships. This page shows
    what the queue looks like right now and how long each item has been taking
    to reach the post — so you can see where your order sits without asking.
  </p>

  <% if Flipper.enabled?(:shop_backlogged) %>
    <p class="queue__banner">
      We're backlogged right now, so orders are taking longer than the numbers
      below suggest. The fraud and fulfillment teams are volunteers with school
      and lives of their own — thank you for being patient with them.
    </p>
  <% end %>

  <ul class="queue__stats">
    <%= render "queue/stat",
               tone: "lilac",
               value: number_with_delimiter(@snapshot.pending_count),
               label: "Orders waiting",
               note: "#{number_with_delimiter(@snapshot.decisions_last_week)} cleared in the last 7 days" %>
    <%= render "queue/stat",
               tone: "peach",
               value: @snapshot.oldest_waiting_at ? distance_of_time_in_words_to_now(@snapshot.oldest_waiting_at) : "—",
               label: "Longest wait so far",
               note: @snapshot.average_wait_hours ? "#{queue_duration_in_words(@snapshot.average_wait_hours)} on average" : nil %>
    <%= render "queue/stat",
               tone: "blue",
               value: queue_duration_in_words(@snapshot.review_average_hours),
               label: "Average review time",
               note: "across the last 30 days" %>
    <%= render "queue/stat",
               tone: "mint",
               value: queue_duration_in_words(@snapshot.fulfillment_average_hours),
               label: "Average time to fulfill",
               note: "order placed to parcel sent" %>
  </ul>

  <section class="queue__section">
    <h2 class="queue__section-title">How long the queue has been waiting</h2>

    <% if @snapshot.pending_count.positive? %>
      <div class="queue__bands" role="img"
           aria-label="<%= @snapshot.age_bands.map { |band| "#{band.label}: #{band.count}" }.join(", ") %>">
        <div class="queue__band-bar">
          <% @snapshot.age_bands.reject { |band| band.count.zero? }.each do |band| %>
            <span class="queue__band-fill queue__band-fill--<%= band.tone %>"
                  style="--queue-band-share: <%= band.share %>%"></span>
          <% end %>
        </div>

        <ul class="queue__band-legend">
          <% @snapshot.age_bands.each do |band| %>
            <li class="queue__band">
              <span class="queue__band-swatch queue__band-swatch--<%= band.tone %>"></span>
              <span class="queue__band-label"><%= band.label %></span>
              <span class="queue__band-count"><%= number_with_delimiter(band.count) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="queue__empty">Nothing is waiting — the queue is completely clear. 🎉</p>
    <% end %>
  </section>

  <section class="queue__section" data-controller="queue-filter">
    <div class="queue__section-head">
      <h2 class="queue__section-title">Turnaround by item</h2>

      <input type="search"
             class="queue__search"
             placeholder="Filter items…"
             aria-label="Filter items by name"
             autocomplete="off"
             data-queue-filter-target="input"
             data-action="input->queue-filter#filter search->queue-filter#filter">
    </div>

    <% if @snapshot.items.any? %>
      <div class="queue__table-scroll">
        <table class="space-table queue__table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Waiting now</th>
              <th scope="col">Average review</th>
              <th scope="col">Average to fulfill</th>
              <th scope="col">Fulfilled orders</th>
            </tr>
          </thead>
          <tbody>
            <% @snapshot.items.each do |item| %>
              <tr data-queue-filter-target="row" data-queue-filter-name="<%= item.name.downcase %>">
                <th scope="row" class="queue__cell-name"><%= item.name %></th>
                <td class="queue__cell-number">
                  <% if item.waiting.positive? %>
                    <%= number_with_delimiter(item.waiting) %>
                  <% else %>
                    <span class="queue__cell-blank">—</span>
                  <% end %>
                </td>
                <td class="queue__cell-number"><%= queue_duration_in_words(item.review_hours) %></td>
                <td class="queue__cell-number"><%= queue_duration_in_words(item.fulfillment_hours) %></td>
                <td class="queue__cell-number queue__cell-muted"><%= number_with_delimiter(item.sample) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <p class="queue__empty" hidden data-queue-filter-target="empty">
        No items match that filter.
      </p>
    <% else %>
      <p class="queue__empty">No orders have moved through the queue yet.</p>
    <% end %>
  </section>

  <p class="queue__footnote">
    Review times cover the last 30 days and fulfillment times the last 90.
    An item needs at least <%= Shop::QueueSnapshot::MIN_SAMPLE %> fulfilled
    orders in that window before its average is shown. Orders for items the
    shop doesn't list publicly are grouped under
    &ldquo;<%= Shop::QueueSnapshot::HIDDEN_ITEM_LABEL %>&rdquo;.
    Updated <%= time_ago_in_words(@snapshot.generated_at) %> ago.
  </p>
</div>
