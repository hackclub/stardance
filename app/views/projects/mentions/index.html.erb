<% content_for :title, "Viral mentions · #{@project.title}" %>

<main class="project-mentions">
  <header class="project-mentions__header">
    <%= link_to "← #{@project.title}", project_path(@project), class: "project-mentions__back", data: { turbo_frame: "_top" } %>
    <h1 class="project-mentions__title">Viral mentions</h1>
    <p class="project-mentions__hint">
      Links you've submitted for the virality bonus, and what reviewers decided.
      <%= link_to "How it works", guide_path(:virality_bonus), class: "project-mentions__link" %>
    </p>
    <%= link_to "Submit a mention", new_project_mention_path(@project), class: "action-btn action-btn--small action-btn--primary" %>
  </header>

  <% if @mentions.any? %>
    <ol class="project-mentions__list">
      <% @mentions.each do |mention| %>
        <li class="project-mentions__item">
          <div class="project-mentions__item-top">
            <% case mention.status %>
            <% when :approved %>
              <span class="status-pill status-pill--approved">Approved · <%= mention.approved_tier.to_s.capitalize %></span>
            <% when :rejected %>
              <span class="status-pill status-pill--rejected">Not approved</span>
            <% else %>
              <span class="status-pill status-pill--pending">Pending review</span>
            <% end %>
            <span class="project-mentions__date">Submitted <%= time_ago_in_words(mention.created_at) %> ago</span>
          </div>
          <%= link_to mention.url, mention.url, class: "project-mentions__url", target: "_blank", rel: "noopener noreferrer" %>
          <% if mention.submitter_notes.present? %>
            <p class="project-mentions__notes"><%= mention.submitter_notes %></p>
          <% end %>
          <% if mention.status == :approved && mention.metric_value %>
            <p class="project-mentions__metric"><%= number_with_delimiter(mention.metric_value) %> <%= mention.metric_name %> on <%= mention.platform %></p>
          <% end %>
          <%# Pending notes may be an unconfirmed imported reply. %>
          <% if mention.status != :pending && mention.reviewer_notes.present? %>
            <p class="project-mentions__reply"><span class="project-mentions__reply-label">Reviewer:</span> <%= mention.reviewer_notes %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="project-mentions__empty">No mentions submitted yet. Got traction on Reddit, Hacker News, GitHub or somewhere else? Submit the link!</p>
  <% end %>
</main>
