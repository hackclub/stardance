<% owner = @project.memberships.find_by(role: :owner)&.user %>
<% content_for :title, @project.title %>
<% content_for :og_title, "#{@project.title} by @#{owner&.display_name} | Stardance" %>
<% content_for :og_description, @project.display_description.present? ? truncate(@project.display_description.to_s, length: 200) : "#{@project.devlogs_count} devlogs · #{(@project.duration_seconds.to_i / 3600.0).round} hours worked" %>
<% content_for :og_image, project_og_image_url(@project, format: :png) %>
<% content_for :twitter_card, "summary_large_image" %>
<% content_for :og_author, owner&.display_name %>
<% if owner&.preference&.search_engine_indexing_off? %>
  <% content_for :head do %>
    <meta name="robots" content="noindex, nofollow">
  <% end %>
<% end %>

<%
  display = @project.display_banner
  banner_url = display ? url_for(display) : image_path("profile/default-banner.png")
  members = @members || @project.users.to_a
  is_member = @is_member
  follower_count = @follower_count || @project.project_follows.size
  viewer_follow = @viewer_follow
  total_hours = @total_hours || (@project.duration_seconds / 3600.0).round
  can_edit_project = @can_edit_project
  admin_editing_project = @admin_editing_project
  # Only highlight the unfinished sections when the user arrived via the
  # "Complete project info" button (which adds ?complete=1).
  highlight_incomplete_fields = (can_edit_project && params[:complete].present?) ? @project.incomplete_info_fields : []
  can_delete_project = policy(@project).destroy? && (!@project.shipped? || policy(@project).force_destroy?)
%>

<div class="app-layout" data-controller="profile-modal">
  <div class="app-layout__main">
    <%= render "shared/inspector", record: @project %>
    <%= turbo_frame_tag "project_hero" do %>
    <% if can_delete_project %>
      <%= form_with(url: project_path(@project), method: :delete, id: "delete-project-form", style: "display: none;") do %>
      <% end %>
    <% end %>

    <% if can_edit_project && (params[:editing].present? || @project.errors.any?) %>

      <%= form_with(model: @project,
                    url: project_path(@project),
                    method: :patch,
                    multipart: true,
                    class: "project-show project-show--editing",
                    data: {
                      turbo: false,
                      controller: "project-form",
                      action: "submit->project-form#onSubmit",
                      "project-form-readme-locked-class-value": "project-show__field--locked",
                      "project-form-incomplete-fields-value": highlight_incomplete_fields.to_json
                    }) do |form| %>
        <%= hidden_field_tag :inline_project_show, "1" %>

        <header class="project-show__hero">
          <div class="project-show__banner<%= ' project-show__banner--empty' unless @project.banner.attached? %><%= ' ai-detected' if current_user&.admin? && @project.banner.attached? && @project.banner.blob.metadata["ai_generated"] %>" data-controller="file-upload" data-file-upload-empty-class-value="project-show__banner--empty" data-file-upload-placeholder-selector-value=".project-show__banner-placeholder">
            <%= image_tag banner_url, alt: "", class: "project-show__banner-image", data: { "file-upload-target": "preview" } %>
            <% unless @project.banner.attached? %>
              <label class="project-show__banner-placeholder">
                <span class="project-show__banner-placeholder-text">Upload screenshot</span>
                <%= form.file_field :banner, accept: Project::ACCEPTED_CONTENT_TYPES.join(","), class: "project-show__banner-input",
                      data: { "file-upload-target": "input", action: "change->file-upload#change" } %>
              </label>
            <% end %>
            <%= link_to back_path,
                        class: "project-show__back",
                        "aria-label": "Back",
                        data: { turbo_frame: "_top" } do %>
              <svg class="project-show__back-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 6l-6 6 6 6" />
              </svg>
            <% end %>

            <% if @project.banner.attached? %>
              <label class="project-show__banner-upload">
                <span>Change Banner</span>
                <%= form.file_field :banner, accept: Project::ACCEPTED_CONTENT_TYPES.join(","), class: "project-show__banner-input",
                      data: { "file-upload-target": "input", action: "change->file-upload#change" } %>
              </label>
            <% end %>
          </div>

          <div class="project-show__panel">
            <div class="project-show__summary">
              <div class="project-show__identity">
                <%= form.text_field :title,
                                    class: "project-show__title-input",
                                    maxlength: 120,
                                    required: true,
                                    aria: { label: "Project title" },
                                    data: {
                                      action: "input->project-form#validateTitle blur->project-form#validateTitle",
                                      "project-form-target": "title"
                                    } %>

                <% if admin_editing_project %>
                  <%= admin_tool do %>
                    <p class="project-show__admin-edit-notice">You're editing <strong><%= @project.title %></strong> — this isn't your project just remember that.</p>
                  <% end %>
                <% end %>

                <div class="project-show__byline">
                  <% if members.any? %>
                    <ul class="project-show__avatars" aria-hidden="true">
                      <% members.first(4).each do |member| %>
                        <li class="project-show__avatars-item">
                          <% if member.slack_id.present? %>
                            <%= image_tag member.avatar, alt: member.display_name, class: "project-show__avatar" %>
                          <% else %>
                            <span class="project-show__avatar project-show__avatar--placeholder">
                              <%= member.display_name.to_s.first&.upcase %>
                            </span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                  <p class="project-show__authors">
                    By
                    <% members.each_with_index do |m, i| %>
                      <%= " and " if i > 0 && i == members.length - 1 %><%= render "shared/username_link", user: m, link_class: "project-show__author",
                          data: { turbo_frame: "_top", turbo_prefetch: "true" } %><%= "," if i < members.length - 2 && members.length > 2 %>
                    <% end %>
                  </p>
                </div>
              </div>

              <ul class="project-show__stats" aria-label="Project stats">
                <li class="project-show__stats-item">
                  <strong class="project-show__stats-num"><%= @project.devlogs_count %></strong>
                  <span class="project-show__stats-label">Devlogs</span>
                </li>
                <li class="project-show__stats-item">
                  <strong class="project-show__stats-num"><%= total_hours %></strong>
                  <span class="project-show__stats-label">Total hours</span>
                </li>
              </ul>
            </div>

            <%= form.text_area :description,
                               class: "project-show__description-input",
                               rows: 2,
                               maxlength: 1000,
                               placeholder: "What are you building?",
                               aria: { label: "Project description" },
                               data: {
                                 action: "input->project-form#validateDescription blur->project-form#validateDescription",
                                 "project-form-target": "description"
                               } %>

            <div class="project-show__edit-grid" data-controller="project-type">
              <div class="project-show__field project-show__field--inline">
                <span>Project type <%= render "shared/help_tooltip", text: "Software projects track coding time with Hackatime. Hardware projects (electronics, 3D printing, robotics, etc.) record a screen/build timelapse instead." %></span>
                <%# Locked once the project has asked for funding or shipped: the
                    stage decides how the ship is paid, so the model refuses the
                    change and a live control here would only fail validation. %>
                <% if @project.hardware_stage_locked? %>
                  <div class="project-show__stage-toggle project-show__stage-toggle--locked" aria-label="Project type (locked)">
                    <span class="project-show__stage-choice-label project-show__stage-choice-label--locked">Software</span>
                    <span class="project-show__stage-choice-label project-show__stage-choice-label--locked project-show__stage-choice-label--selected">Hardware</span>
                  </div>
                <% else %>
                  <div class="project-show__stage-toggle" role="radiogroup" aria-label="Project type">
                    <label class="project-show__stage-choice">
                      <input type="radio" name="project_type_selector" value="software" class="project-show__stage-radio"
                             <%= "checked" unless @project.hardware? %>
                             data-project-type-target="typeRadio"
                             data-action="change->project-type#sync">
                      <span class="project-show__stage-choice-label">Software</span>
                    </label>
                    <label class="project-show__stage-choice">
                      <input type="radio" name="project_type_selector" value="hardware" class="project-show__stage-radio"
                             <%= "checked" if @project.hardware? %>
                             data-project-type-target="typeRadio"
                             data-action="change->project-type#sync">
                      <span class="project-show__stage-choice-label">Hardware</span>
                    </label>
                  </div>
                <% end %>
              </div>

              <%# Hardware vs software is derived purely from hardware_stage. This
                  empty field clears the column to "" (→ nil via the model
                  normalizer) for software projects; when Hardware is selected the
                  enabled stage radios below submit after it and win (last value). %>
              <%= hidden_field_tag "project[hardware_stage]", "" %>

              <div class="project-show__field project-show__field--inline"
                   data-project-type-target="stageSection"
                   <%= "hidden" unless @project.hardware? %>>
                <span>Project stage <%= render "shared/help_tooltip", text: "\"Design\" means you're still designing and need a grant to buy parts. Submit your design for funding to move to building. \"Build\" means you already have your parts and are building." %></span>
                <% if @project.hardware_stage_locked? %>
                  <% fr = @project.latest_funding_request %>
                  <div class="project-show__stage-toggle project-show__stage-toggle--locked" aria-label="Project stage (locked)">
                    <span class="project-show__stage-choice-label project-show__stage-choice-label--locked">
                      <% if fr.nil? %>
                        Design Stage
                      <% elsif fr.issues_grant? %>
                        Design Stage — $<%= fr.final_amount_dollars %> approved
                      <% elsif fr.approved? %>
                        Design Stage — approved
                      <% elsif fr.pending? %>
                        Design Stage — $<%= fr.requested_amount_dollars %> under review
                      <% else %>
                        Design Stage — funding returned
                      <% end %>
                    </span>
                    <span class="project-show__stage-choice-label project-show__stage-choice-label--locked project-show__stage-choice-label--selected">
                      Build Stage
                    </span>
                  </div>
                  <%# Keep hardware_stage as "build" so the form still submits correctly %>
                  <%= form.hidden_field :hardware_stage, value: @project.hardware_stage %>
                <% else %>
                  <div class="project-show__stage-toggle" role="radiogroup" aria-label="Project stage">
                    <label class="project-show__stage-choice">
                      <%= form.radio_button :hardware_stage, "design", class: "project-show__stage-radio", disabled: !@project.hardware?, data: { "project-type-target": "stageRadio" } %>
                      <span class="project-show__stage-choice-label">Design</span>
                    </label>
                    <label class="project-show__stage-choice">
                      <%= form.radio_button :hardware_stage, "build", class: "project-show__stage-radio", disabled: !@project.hardware?, data: { "project-type-target": "stageRadio" } %>
                      <span class="project-show__stage-choice-label">Build</span>
                    </label>
                  </div>
                <% end %>
              </div>

              <div class="project-show__field project-show__field--inline project-show__field--hackatime">
                <span>Hackatime projects</span>
                <% if !@hackatime_linked %>
                  <button type="submit"
                          form="hackatime-connect-form"
                          class="project-show__hackatime-connect">
                    Connect Hackatime to link projects →
                  </button>
                <% elsif @hackatime_dropdown_items.blank? %>
                  <span class="project-show__hackatime-empty">
                    No Hackatime projects yet — start coding with Hackatime installed to see them here.
                  </span>
                <% else %>
                  <div data-controller="hackatime-link"
                       data-hackatime-link-has-existing-devlogs-value="<%= @project_has_devlogs %>">
                    <div class="project-show__hackatime-picker">
                      <div class="project-show__hackatime-box" role="button" tabindex="0" aria-pressed="false" data-contoller="addBtn" data-action="click->hackatime-link#toggle keydown.enter->hackatime-link#toggle">
                        <div class="project-show__hackatime-add" aria-label="Add Hackatime project">
                          <%= inline_svg_tag "icons/plus.svg", class: "project-show__hackatime-add-icon" %>
                        </div>
                        <div class="project-show__hackatime-tags" data-hackatime-link-target="tags">
                          <span class="project-show__hackatime-placeholder"
                                data-hackatime-link-target="placeholder"
                                <%= "hidden" if @linked_hackatime_projects.any? %>>
                            Link a Project
                          </span>
                          <% @linked_hackatime_projects.each do |hp| %>
                            <span class="project-show__hackatime-tag" data-hackatime-id="<%= hp.id %>" data-previously-linked="true">
                              <span class="project-show__hackatime-tag-name"><%= hp.name %></span>
                              <span class="project-show__hackatime-tag-time"><%= format_seconds(@hackatime_times[hp.name] || 0) %></span>
                              <button type="button" class="project-show__hackatime-tag-remove" data-action="hackatime-link#remove" data-id="<%= hp.id %>" aria-label="Remove <%= hp.name %>">
                                <%= inline_svg_tag "icons/close.svg", class: "project-show__hackatime-tag-remove-icon" %>
                              </button>
                              <input type="hidden" name="project[hackatime_project_ids][]" value="<%= hp.id %>">
                            </span>
                          <% end %>
                        </div>
                      </div>

                      <div class="project-show__hackatime-dropdown" data-hackatime-link-target="dropdown" hidden>
                        <div class="project-show__hackatime-dropdown-items">
                          <% @hackatime_dropdown_items.reject { |i| i[:linked] }.each do |item| %>
                            <button type="button"
                                    class="project-show__hackatime-dropdown-item<%= " project-show__hackatime-dropdown-item--taken" if item[:taken] %>"
                                    data-action="hackatime-link#select"
                                    data-id="<%= item[:id] %>"
                                    data-name="<%= item[:name] %>"
                                    data-hours="<%= item[:hours] %>"
                                    <%= "disabled" if item[:taken] %>>
                              <span class="project-show__hackatime-dropdown-name"><%= item[:name] %></span>
                              <span class="project-show__hackatime-dropdown-time"><%= format_seconds(item[:seconds]) %></span>
                              <% if item[:taken] %>
                                <span class="project-show__hackatime-dropdown-taken">linked to <%= item[:taken_by] %></span>
                              <% end %>
                            </button>
                          <% end %>
                        </div>
                        <%= link_to "CAN'T FIND YOUR PROJECT? →", guide_path(:hackatime), class: "project-show__hackatime-dropdown-help", data: { turbo_frame: "_top" } %>
                      </div>
                    </div>
                  </div>
                <% end %>
                <% if @hackatime_token_stale %>
                  <div class="project-show__hackatime-stale">
                    <span>Your Hackatime connection may be outdated — hours might be inaccurate.</span>
                    <button type="button" class="project-show__hackatime-reconnect" onclick="document.getElementById('settings-modal').showModal()">
                      Reconnect in settings →
                    </button>
                  </div>
                <% end %>
              </div>

              <label class="project-show__field project-show__field--inline">
                <span>AI usage declaration <%= render "shared/help_tooltip", text: "Describe how you used AI in this project (e.g. \"Used ChatGPT for debugging\", \"GitHub Copilot for code completion\"). AI use is OK, but it should feel like your own work! If you didn't use AI, write \"None\"." %></span>
                <%= form.text_area :ai_declaration,
                                   rows: 2,
                                   maxlength: 1000,
                                   class: "project-show__control project-show__textarea",
                                   placeholder: "How did you use AI? Write \"None\" if you didn't.",
                                   aria: { label: "AI usage declaration" },
                                   data: { "project-form-target": "aiDeclaration" } %>
              </label>

              <label class="project-show__started-check">
                <input class="project-show__started-check-input"
                       type="checkbox"
                       data-project-form-target="updateDeclaration"
                       data-action="change->project-form#toggleUpdateDescription"
                       <%= "checked" if @project.update_description.present? %>
                       aria-label="This project was started before June 1 2026, or was previously shipped to a Hack Club event.">
                <span>This project was started <strong>before June 1 2026</strong>, or was <strong>previously shipped</strong> to a Hack Club event.</span>
              </label>

              <label class="project-show__field project-show__field--inline"
                     data-project-form-target="updateDescriptionContainer"
                     <%= "hidden" if @project.update_description.blank? %>>
                <span>Update Description <%= render "shared/help_tooltip", text: "Describe the features you've added or updated, and the impact these changes have had on your project overall. Please be specific." %></span>
                <%= form.text_area :update_description,
                                   rows: 3,
                                   maxlength: 1000,
                                   class: "project-show__control project-show__textarea",
                                   placeholder: "What did you update and why?",
                                   aria: { label: "Update description" },
                                   data: { "project-form-target": "updateDescriptionField" } %>
              </label>

              <div class="project-show__sparkle" aria-hidden="true"></div>

              <label class="project-show__field project-show__field--inline">
                <span>Demo URL <%= render "shared/help_tooltip", text: @project.hardware? ? "An IRL video of your project working." : "A live URL where anyone can try your project." %></span>
                <%= form.url_field :demo_url,
                                   class: "project-show__control",
                                   placeholder: "https://example.com",
                                   inputmode: "url",
                                   data: {
                                     action: "input->project-form#validateUrl blur->project-form#validateUrl",
                                     "project-form-target": "demoUrl"
                                   } %>
              </label>

              <label class="project-show__field project-show__field--inline">
                <span>Github URL <%= render "shared/help_tooltip", text: "A public repository URL." %></span>
                <%= form.url_field :repo_url,
                                   class: "project-show__control",
                                   placeholder: "https://github.com/user/repo",
                                   inputmode: "url",
                                   data: {
                                     action: "input->project-form#onRepoInput blur->project-form#onRepoBlur",
                                     "project-form-target": "repoUrl"
                                   } %>
              </label>

              <label class="project-show__field project-show__field--inline"
                     data-project-form-target="readmeContainer"
                     <%= "hidden" if @project.readme_url.blank? %>>
                <span>Readme URL <%= render "shared/help_tooltip", text: "A raw README URL for your project page." %></span>
                <%= form.url_field :readme_url,
                                   class: "project-show__control",
                                   placeholder: "https://raw.githubusercontent.com/user/repo/main/README.md",
                                   inputmode: "url",
                                   data: {
                                     action: "input->project-form#onReadmeInput input->project-form#validateUrl blur->project-form#validateUrl",
                                     "project-form-target": "readmeUrl"
                                   } %>
              </label>
            </div>

            <div class="project-show__panel-actions">
              <% if @project.fire? %>
                <span class="project-show__badge project-show__badge--fire">⭐ Super Star Project</span>
              <% end %>
              <% if can_delete_project %>
                <button type="button"
                        class="project-show__pill project-show__pill--destructive"
                        onclick="document.getElementById('delete-project-modal').showModal()">Delete project</button>
              <% end %>
              <%= link_to "Discard changes", project_path(@project), class: "project-show__pill project-show__pill--outline", data: { turbo_frame: "project_hero" } %>
              <%= form.submit "Save", class: "project-show__pill project-show__pill--save", data: { "project-form-target": "submit" } %>
            </div>
          </div>
        </header>
      <% end %>
      <% unless @hackatime_linked %>
        <form id="hackatime-connect-form" method="post" action="/auth/hackatime" hidden>
          <input type="hidden" name="origin" value="<%= request.fullpath %>">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        </form>
      <% end %>
    <% else %>
      <article class="project-show">
        <header class="project-show__hero">
          <div class="project-show__banner <%= 'ai-detected' if current_user&.admin? && @project.banner.attached? && @project.banner.blob.metadata["ai_generated"] %>">
            <%= image_tag banner_url, alt: "", class: "project-show__banner-image" %>
            <%= link_to back_path,
                        class: "project-show__back",
                        "aria-label": "Back",
                        data: { turbo_frame: "_top" } do %>
              <svg class="project-show__back-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 6l-6 6 6 6" />
              </svg>
            <% end %>
          </div>

          <div class="project-show__panel project-show__panel--read">
            <div class="project-show__summary">
              <div class="project-show__identity">
                <div class="project-show__title-row">
                  <h1 class="project-show__title"><%= @project.title %></h1>
                  <% if @project.hardware? %>
                    <span class="project-show__tag project-show__tag--hardware">Hardware</span>
                  <% end %>
                  <%= admin_tool(compact: true, roles: [ :fraud_dept, :helper, :nda_helper ]) do %>
                    <%= link_to "🔨", admin_project_path(@project), class: "project-show__admin-link", data: { turbo_frame: "_top" }, "aria-label": "View #{@project.title} in admin" %>
                  <% end %>
                </div>
                <div class="project-show__byline">
                  <% if members.any? %>
                    <ul class="project-show__avatars" aria-hidden="true">
                      <% members.first(4).each do |member| %>
                        <li class="project-show__avatars-item">
                          <% if member.slack_id.present? %>
                            <%= image_tag member.avatar, alt: member.display_name, class: "project-show__avatar" %>
                          <% else %>
                            <span class="project-show__avatar project-show__avatar--placeholder">
                              <%= member.display_name.to_s.first&.upcase %>
                            </span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                  <p class="project-show__authors">
                    By
                    <% members.each_with_index do |m, i| %>
                      <%= " and " if i > 0 && i == members.length - 1 %><%= render "shared/username_link", user: m, link_class: "project-show__author",
                          data: { turbo_frame: "_top", turbo_prefetch: "true" } %><%= "," if i < members.length - 2 && members.length > 2 %>
                    <% end %>
                  </p>
                </div>
              </div>

              <ul class="project-show__stats" aria-label="Project stats">
                <li class="project-show__stats-item">
                  <strong class="project-show__stats-num"><%= @project.devlogs_count %></strong>
                  <span class="project-show__stats-label">Devlogs</span>
                </li>
                <li class="project-show__stats-item">
                  <strong class="project-show__stats-num"><%= total_hours %></strong>
                  <span class="project-show__stats-label">Total hours</span>
                </li>
              </ul>
            </div>

            <% if @project.description.present? %>
              <p class="project-show__description"><%= @project.description %></p>
            <% end %>

            <div class="project-show__read-footer">
              <%= button_tag type: "button",
                             class: "project-show__followers",
                             data: { action: "click->profile-modal#open",
                                     "profile-modal-url-param": followers_project_path(@project),
                                     "profile-modal-title-param": "Followers" } do %>
                <strong><%= follower_count %></strong> <%= "follower".pluralize(follower_count) %>
              <% end %>
              <div class="project-show__panel-actions">
                <%= render "projects/fire_controls", project: @project %>

                <% if (safe_repo_url = safe_external_url(@project.repo_url)) %>
                  <%= link_to safe_repo_url,
                              class: "project-show__pill project-show__pill--outline project-show__pill--github",
                              target: "_blank",
                              rel: "noopener noreferrer",
                              aria: { label: "View source on GitHub" } do %>
                    <%= inline_svg_tag "icons/github.svg", class: "project-show__github-icon" %>
                    Source
                  <% end %>
                <% end %>

                <% if can_edit_project %>
                  <% edit_project_link = capture do %>
                    <%= link_to "Edit project", project_path(@project, editing: true),
                                class: "project-show__pill project-show__pill--outline",
                                data: { turbo_frame: "project_hero" } %>
                  <% end %>

                  <% if admin_editing_project %>
                    <%= admin_tool do %>
                      <%= edit_project_link %>
                    <% end %>
                  <% else %>
                    <%= edit_project_link %>
                  <% end %>
                <% end %>

                <% if current_user && !is_member %>
                  <%= link_to (viewer_follow ? "Following" : "Follow"),
                              (viewer_follow ? unfollow_project_path(@project) : follow_project_path(@project)),
                              class: [ "project-show__pill", "project-show__pill--save", ("project-show__pill--following" if viewer_follow) ].compact.join(" "),
                              data: {
                                turbo_method: (viewer_follow ? :delete : :post),
                                turbo_frame: "_top"
                              } %>
                <% end %>

                <% if Flipper.enabled?(:hardware_flow, current_user) && @project.hardware? && !is_member && current_user&.can_review? %>
                  <%= link_to "Review", admin_certification_hardware_review_path(@project),
                              class: "project-show__pill project-show__pill--outline project-show__pill--review",
                              data: { turbo_frame: "_top" } %>
                <% end %>

                <%= render "projects/report_button", project: @project, is_member: is_member %>
              </div>
            </div>
          </div>
        </header>
      </article>
    <% end %>
    <% end %>

    <% if is_member %>
      <% if @hackatime_linked || @test_time_granted %>
        <%
          no_hackatime_project = @project.hackatime_keys.blank? && !@test_time_granted
          unposted_seconds = @unposted_seconds.to_i
          enough_time = !no_hackatime_project && (unposted_seconds >= 15 * 60 || @test_time_granted)
          devlog_disabled_message = "Edit this project to add a Hackatime project" if no_hackatime_project
          # Only call it the primary action when devlogging is actually
          # actionable right now — i.e. you have a Hackatime project AND at
          # least 15m of unposted time. Otherwise it stays secondary.
          devlog_primary = @project.next_step_is_devlog? && enough_time
          devlog_modifier_class = devlog_primary ? "project-show__action--primary" : "project-show__action--secondary"
        %>
        <nav class="project-show__actions" aria-label="Project actions">
          <% if Flipper.enabled?(:hardware_flow, current_user) && @project.hardware? %>
            <%= render "projects/record_timelapse_button",
                       project: @project,
                       disabled_message: (@hackatime_linked ? nil : "Link your Hackatime account to start recording") %>
          <% end %>
          <% devlog_variant = devlog_primary ? :primary : :secondary %>
          <% if devlog_disabled_message %>
            <%= render ActionButtonComponent.new(
                  text: "Post a devlog +",
                  variant: devlog_variant,
                  type: :button,
                  disabled: :soft,
                  data: {
                    controller: "tooltip",
                    tooltip_message_value: devlog_disabled_message,
                    tooltip_position_value: "top"
                  }
                ) %>
          <% else %>
            <%= render ActionButtonComponent.new(
                  text: "Post a devlog +",
                  variant: devlog_variant,
                  type: :button,
                  onclick: "document.getElementById('composer-modal-' + #{@project.id.to_json}).showModal()"
                ) %>
          <% end %>
          <% unless @project.stage_info_complete? %>
            <% if @project.has_devlog_since_last_ship? %>
              <%= render ActionButtonComponent.new(
                    text: "Complete project info",
                    variant: :primary,
                    href: project_path(@project, editing: true, complete: true),
                    data: {
                      turbo_frame: "project_hero",
                      controller: "tooltip",
                      tooltip_message_value: @project.info_blocker_message,
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% else %>
              <%= render ActionButtonComponent.new(
                    text: "Complete project info",
                    variant: :secondary,
                    type: :button,
                    disabled: :soft,
                    data: {
                      controller: "tooltip",
                      tooltip_message_value: "Post at least one devlog first",
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% end %>
          <% end %>
          <% if is_member && current_user && @project.stage_info_complete? %>
            <% unless current_user.identity_verified? %>
              <%= render ActionButtonComponent.new(
                    text: "Verify your identity",
                    variant: :primary,
                    type: :button,
                    onclick: "document.getElementById('idv-verify-modal').showModal()"
                  ) %>
            <% else %>
              <% unless current_user.shop_tutorial_completed? %>
                <%= render ActionButtonComponent.new(
                      text: "Complete shop tutorial",
                      variant: :primary,
                      href: "/shop"
                    ) %>
              <% end %>
            <% end %>
          <% end %>
          <% if Flipper.enabled?(:hardware_flow, current_user) && is_member && @project.design_stage? %>
            <% if @project.has_pending_funding_request? %>
              <%= render ActionButtonComponent.new(
                    text: "Funding request under review",
                    variant: :secondary,
                    type: :button,
                    disabled: :soft,
                    data: {
                      controller: "tooltip",
                      tooltip_message_value: "We're reviewing your design. You'll be switched to building once it's approved.",
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% elsif !@project.has_devlog_since_last_ship? %>
              <%= render ActionButtonComponent.new(
                    text: "Submit for funding",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    disabled: :soft,
                    data: {
                      controller: "tooltip",
                      tooltip_message_value: "Post at least one devlog before requesting funding!",
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% elsif !@project.funding_info_complete? %>
              <%= render ActionButtonComponent.new(
                    text: "Submit for funding",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    disabled: :soft,
                    data: {
                      controller: "tooltip",
                      tooltip_message_value: "Complete project info first!",
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% elsif !owner&.identity_verified? || !owner.ysws_eligible? %>
              <%= render ActionButtonComponent.new(
                    text: @project.awards_design_kit? ? "Submit your design" : "Submit for funding",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    disabled: :soft,
                    data: {
                      controller: "tooltip",
                      tooltip_message_value: owner&.identity_verified? ?
                        "You're not eligible for YSWS prizes yet, check the Hack Club portal!" :
                        "Verify your identity before requesting funding!",
                      tooltip_position_value: "top"
                    }
                  ) %>
            <% else %>
              <%= render ActionButtonComponent.new(
                    text: @project.awards_design_kit? ? "Submit your design" : "Submit for funding",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    onclick: "document.getElementById('funding-request-modal-' + #{@project.id.to_json}).showModal()"
                  ) %>
            <% end %>
          <% end %>
          <%# "I need Funding" (design-stage) projects must get a grant first —
              the ship button stays hidden behind the funding button until the
              grant flips them to the build stage. %>
          <% unless @project.design_stage? %>
          <% if @project.awaiting_ship_review? %>
            <%= render ActionButtonComponent.new(
                  text: "Ship your project!",
                  variant: :secondary,
                  type: :button,
                  icon: "icons/rocket.png",
                  disabled: :soft,
                  data: {
                    controller: "tooltip",
                    tooltip_message_value: "Your project is in review. You can ship again once it's approved.",
                    tooltip_position_value: "top"
                  }
                ) %>
          <% elsif @project.needs_changes? %>
            <%# Changes requested: the ship CTA resubmits this same ship for
                re-certification instead of opening a fresh ship. %>
            <%= render ActionButtonComponent.new(
                  text: "Ship your project!",
                  variant: :primary,
                  type: :button,
                  icon: "icons/rocket.png",
                  onclick: "document.getElementById('recert-modal-' + #{@project.id.to_json}).showModal()"
                ) %>
          <% elsif @project.shippable? %>
            <% if unposted_seconds >= 15 * 60 %>
              <%= render ActionButtonComponent.new(
                    text: "Ship your project!",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    onclick: "document.getElementById('ship-warning-modal-' + #{@project.id.to_json}).showModal()"
                  ) %>
            <% else %>
              <%= render ActionButtonComponent.new(
                    text: "Ship your project!",
                    variant: :primary,
                    type: :button,
                    icon: "icons/rocket.png",
                    onclick: "document.getElementById('ship-video-modal-' + #{@project.id.to_json}).showModal()"
                  ) %>
            <% end %>
          <% else %>
            <%
              ship_disabled_message =
                if (mission_review_message = @project.mission_review_blocker_message)
                  mission_review_message
                elsif @project.received_grant? && !@project.has_build_devlog_since_last_ship?
                  "Post at least one build devlog before you can ship!"
                elsif !@project.has_devlog_since_last_ship?
                  "Post at least one devlog before shipping!"
                elsif !@project.info_complete?
                  "Complete your project info before shipping!"
                else
                  # Some other requirement (payout, vote balance, rejection,
                  # tracked time) isn't met — tell them which one.
                  @project.ship_blocker_message || "Finish the remaining requirements before shipping."
                end
            %>
            <%= render ActionButtonComponent.new(
                  text: "Ship your project!",
                  variant: :secondary,
                  type: :button,
                  icon: "icons/rocket.png",
                  disabled: :soft,
                  data: {
                    controller: "tooltip",
                    tooltip_message_value: ship_disabled_message,
                    tooltip_position_value: "top"
                  }
                ) %>
          <% end %>
          <% end %>
        </nav>
        <% if unposted_seconds >= Post::ShipEvent::DEVLOG_CAP_WARNING_SECONDS %>
          <%
            unposted_time = format_hours_minutes(unposted_seconds)
            over_cap = unposted_seconds > Post::ShipEvent::MAX_PAYOUT_SECONDS_PER_DEVLOG
          %>
          <p class="<%= class_names("project-show__devlog-cap-warning", "project-show__devlog-cap-warning--over" => over_cap) %>">
            <%= inline_svg_tag "icons/warning.svg", class: "project-show__devlog-cap-warning-icon", aria: { hidden: true } %>
            <% if over_cap %>
              <span>You have <strong><%= unposted_time %></strong> without a devlog- only <%= Post::ShipEvent::MAX_PAYOUT_HOURS_PER_DEVLOG %>h of it can count toward your ship payout. Post a devlog now so you don't lose more!</span>
            <% else %>
              <span>You have <strong><%= unposted_time %></strong> without a devlog. Only <%= Post::ShipEvent::MAX_PAYOUT_HOURS_PER_DEVLOG %>h per devlog counts toward your ship payout- post one soon!</span>
            <% end %>
          </p>
        <% end %>
      <% else %>
        <nav class="project-show__actions" aria-label="Project actions">
          <% if Flipper.enabled?(:hardware_flow, current_user) && @project.hardware? %>
            <%= render "projects/record_timelapse_button",
                       project: @project,
                       disabled_message: "Link your Hackatime account to start recording" %>
          <% end %>
          <%= button_to "/auth/hackatime",
                        method: :post,
                        params: { origin: request.fullpath },
                        class: "action-btn action-btn--large action-btn--primary project-show__hackatime-cta",
                        form: { class: "project-show__action-form" } do %>
            Link Hackatime to track your project time<%= inline_svg_tag "icons/right-arrow.svg", class: "action-btn__icon action-btn__icon--trailing", aria: { hidden: true } %>
          <% end %>
        </nav>
      <% end %>

    <% end %>

    <% if is_member && Flipper.enabled?(:test_time, current_user) %>
      <%= button_to "Add 15min (test)",
                    add_test_time_project_path(@project),
                    method: :post,
                    class: "action-btn action-btn--large action-btn--secondary project-show__test-time",
                    form: { class: "project-show__test-time-form" } %>
    <% end %>

    <% if is_member && params[:just_shipped].present? %>
      <%
        latest_submission = @latest_ship_post&.postable&.mission_submission
        is_fixed_payout = latest_submission&.payout_path == "static_prize" &&
                          latest_submission&.mission&.fixed_stardust_payout&.positive?
        skip_voting = is_fixed_payout || @project.hardware?

        ship_tour_text = if is_fixed_payout
          "Your ship is now in review. Once it's approved, you'll earn the mission's prizes!"
        elsif @project.hardware?
          "Your ship is now in review. Once it's approved, you'll get your payout!"
        else
          "Yay congrats on your first ship! To get your payout, you need to vote at least #{Post::ShipEvent::VOTE_COST_PER_SHIP} times on other people's projects."
        end

        ship_tour_steps = [
          {
            selector: skip_voting ? "body" : "[data-onboarding-target='rate']",
            text: ship_tour_text,
            padding: 12,
            radius: 12,
            position: skip_voting ? "center" : nil
          }.compact
        ]
      %>
      <div class="welcome-tour"
           data-controller="welcome-tour"
           data-welcome-tour-steps-value="<%= ship_tour_steps.to_json %>"
           role="dialog"
           aria-modal="true"
           aria-label="Post-ship tour">
        <div class="welcome-tour__overlay" aria-hidden="true"></div>
        <div class="welcome-tour__spotlight"
             data-welcome-tour-target="spotlight"
             aria-hidden="true"></div>

        <div class="welcome-tour__tooltip" data-welcome-tour-target="tooltip">
          <%= inline_svg_tag "icons/tour-arrow.svg",
                             class: "welcome-tour__arrow",
                             aria: { hidden: true },
                             focusable: false %>

          <p class="welcome-tour__text" data-welcome-tour-target="text"></p>
          <p class="welcome-tour__subtitle" data-welcome-tour-target="subtitle" hidden></p>

          <div class="welcome-tour__actions">
            <button type="button"
                    class="welcome-tour__back"
                    data-welcome-tour-target="back"
                    data-action="click->welcome-tour#back"
                    hidden>
              Back
            </button>
            <button type="button"
                    class="welcome-tour__next"
                    data-welcome-tour-target="next"
                    data-action="click->welcome-tour#next">
            </button>
          </div>

          <span class="welcome-tour__counter"
                data-welcome-tour-target="counter"
                aria-hidden="true"></span>
        </div>
      </div>
    <% end %>

    <% if @show_project_onboarding %>
      <% onboarding_mission = @project_onboarding_mission %>
      <% verb = @project.hardware? ? "build" : "code" %>
      <% time_kind = @project.hardware? ? "timelapse" : "coding" %>
      <section class="project-show__onboarding" aria-labelledby="project-show-onboarding-title">
        <header class="project-show__onboarding-header">
          <% onboarding_banner = onboarding_mission&.banner&.attached? %>
          <% onboarding_image = onboarding_banner ? onboarding_mission.banner : onboarding_mission&.icon %>
          <% if onboarding_image&.attached? %>
            <%= image_tag onboarding_image, alt: "", class: class_names("project-show__onboarding-image", "project-show__onboarding-image--icon" => !onboarding_banner) %>
          <% end %>

          <h2 class="project-show__onboarding-header-title" id="project-show-onboarding-title">
            <%= onboarding_mission ? onboarding_mission.name : (@hackatime_linked ? "You're all set — go #{verb}!" : "Welcome to your new project!") %>
          </h2>

          <%# Time-tracking nudge, shown for every new project, mission or not. %>
          <% if !@hackatime_linked %>
            <p class="project-show__onboarding-header-body">
              <% if onboarding_mission&.has_guide? %>
                First, link Hackatime to make sure your time is logged, and then open the guide to get started!
              <% else %>
                First, link Hackatime to make sure your time is logged, then get started building!
              <% end %>
            </p>
          <% elsif @project.hackatime_keys.present? %>
            <p class="project-show__onboarding-header-body">
              Once you have 15 minutes of <%= time_kind %> time, come back and write your first devlog! Keep posting devlogs as you build- only up to <%= Post::ShipEvent::MAX_PAYOUT_HOURS_PER_DEVLOG %> hours per devlog counts toward your payout when you ship.
            </p>
          <% elsif @all_hackatime_projects.present? %>
            <p class="project-show__onboarding-header-body">
              We found Hackatime projects on your account — <%= link_to "edit your project", project_path(@project, editing: true), class: "project-show__onboarding-header-link", data: { turbo_frame: "project_hero" } %> to link one. Once you have 15 minutes of <%= time_kind %> time, write your first devlog!
            </p>
          <% else %>
            <p class="project-show__onboarding-header-body">
              Start coding with Hackatime running. Once you have 15 minutes, <%= link_to "edit your project", project_path(@project, editing: true), class: "project-show__onboarding-header-link", data: { turbo_frame: "project_hero" } %> to link your Hackatime project, then write your first devlog!
            </p>
          <% end %>
        </header>

        <%# Prominent guide CTA: the mission's own guide when on a mission,
            otherwise the hardware getting-started guide for hardware projects. %>
        <% if onboarding_mission&.has_guide? %>
          <% guide_href = onboarding_mission.external_guide? ? onboarding_mission.guide_url : guide_mission_path(onboarding_mission.slug) %>
          <%= link_to guide_href,
                      class: "action-btn action-btn--large action-btn--primary project-show__onboarding-cta",
                      target: onboarding_mission.external_guide? ? "_blank" : nil,
                      rel: onboarding_mission.external_guide? ? "noopener" : nil,
                      data: { turbo: false } do %>
            Open the guide!<%= inline_svg_tag "icons/right-arrow.svg", class: "action-btn__icon action-btn__icon--trailing", aria: { hidden: true } %>
          <% end %>
        <% elsif Flipper.enabled?(:hardware_flow, current_user) && @project.hardware? %>
          <%= link_to guide_path("hardware"),
                      class: "action-btn action-btn--large action-btn--primary project-show__onboarding-cta",
                      target: "_blank", rel: "noopener",
                      data: { turbo: false } do %>
            Read on how to start your hardware project!<%= inline_svg_tag "icons/right-arrow.svg", class: "action-btn__icon action-btn__icon--trailing", aria: { hidden: true } %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <%# Pinned above the feed rather than sorted into it: nothing else on the
        project can move until the builder answers it. %>
    <% if @queue_mismatch_review %>
      <section class="project-show__feed" aria-label="Question from a reviewer">
        <%= render "projects/queue_mismatch_card", review: @queue_mismatch_review, project: @project %>
      </section>
    <% end %>

    <% if @timeline_entries.any? %>
      <section class="project-show__feed" aria-label="Project feed">
        <% ship_count = @posts.count { |p| p.postable_type == "Post::ShipEvent" } %>
        <% ship_index = 0 %>
        <% @timeline_entries.each do |entry| %>
          <% if entry.is_a?(Certification::Ship) %>
            <%= render "projects/ship_decision_card", decision: entry, is_member: is_member, project: @project %>
          <% elsif entry.is_a?(Certification::FundingRequest) %>
            <%# The resubmit button reuses the funding modal, which only renders
                while the project is still in the design stage. It belongs on the
                latest review only - older returned reviews are history the
                builder has already moved past. %>
            <% resubmit_available = Flipper.enabled?(:hardware_flow, current_user) && @project.design_stage? %>
            <% resubmit_id = (resubmit_available && entry == @project.latest_funding_request) ? "funding-request-modal-#{@project.id}" : nil %>
            <%= render "projects/funding_request_card",
                       funding_request: entry, project: @project, owner: owner,
                       resubmit_modal_id: resubmit_id %>
          <% elsif entry.postable_type == "Post::ShipEvent" %>
            <% ship_index += 1 %>
            <% recert_id = ((is_member || current_user&.can_review?) && @project.needs_changes? && ship_index == 1) ? "recert-modal-#{@project.id}" : nil %>
            <%
              mission_sub = entry.postable&.mission_submission
              mission_modal_id = if (is_member || current_user&.admin?) && @rejected_mission_sub && mission_sub == @rejected_mission_sub
                "mission-resubmit-modal-#{@project.id}"
              end
            %>
            <%= render "projects/ship_card",
                       post: entry,
                       project: @project,
                       ship_number: ship_count - ship_index + 1,
                       recert_modal_id: recert_id,
                       is_member: is_member,
                       payout_review: entry.postable == @votes_for_payout&.dig(:ship_event) ? @votes_for_payout : nil,
                       mission_resubmit_modal_id: mission_modal_id %>
          <% else %>
            <%= render PostComponent.new(post: entry, current_user: current_user, theme: :profile_dark, lazy_media: true) %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <% if @votes_for_payout&.dig(:review_deadline) %>
      <%= render "projects/payout_review_modal", payout_review: @votes_for_payout %>
    <% end %>

  </div>

  <% if (is_member || current_user&.can_review?) && @project.needs_changes? %>
    <%= render "projects/recert_modal", project: @project, is_member: is_member %>
  <% end %>

  <% if (is_member || current_user&.admin?) && @rejected_mission_sub %>
    <%= render "projects/mission_resubmit_modal", project: @project, submission: @rejected_mission_sub, is_member: is_member %>
  <% end %>

  <% if is_member && @composer_devlog && @composer_projects %>
    <dialog id="composer-modal-<%= @project.id %>"
            class="composer-modal"
            data-controller="modal"
            aria-label="Post a devlog">
      <%= render Posts::ComposerComponent.new(
            post: @composer_devlog,
            current_user: current_user,
            projects: @composer_projects,
            selected_project: @project,
            test_time_granted: @test_time_granted
          ) %>
    </dialog>
  <% end %>

  <% if is_member && @hackatime_linked && @project.has_devlog_since_last_ship? %>
    <%
      ship_warn_seconds = @unposted_seconds.to_i
      ship_warn_hours = ship_warn_seconds / 3600
      ship_warn_minutes = (ship_warn_seconds % 3600) / 60
      ship_warn_time = ship_warn_hours > 0 ? "#{ship_warn_hours}h #{ship_warn_minutes}m" : "#{ship_warn_minutes}m"
    %>
    <dialog id="ship-warning-modal-<%= @project.id %>"
            class="ship-warning-modal"
            data-controller="modal"
            aria-labelledby="ship-warning-modal-<%= @project.id %>-title">
      <div class="ship-warning-modal__body">
        <h3 id="ship-warning-modal-<%= @project.id %>-title" class="ship-warning-modal__title">Warning</h3>
        <p class="ship-warning-modal__text">
          You have <strong><%= ship_warn_time %></strong> logged that you haven't posted a devlog for. If you ship without posting a devlog, this time will be lost!
        </p>
        <div class="ship-warning-modal__actions">
          <button type="button"
                  class="ship-warning-modal__btn ship-warning-modal__btn--secondary"
                  onclick="document.getElementById('ship-warning-modal-' + <%= @project.id.to_json %>).close(); document.getElementById('composer-modal-' + <%= @project.id.to_json %>).showModal()">
            Post a devlog
          </button>
          <button type="button"
                  class="ship-warning-modal__btn ship-warning-modal__btn--primary"
                  onclick="document.getElementById('ship-warning-modal-' + <%= @project.id.to_json %>).close(); document.getElementById('ship-video-modal-' + <%= @project.id.to_json %>).showModal()">
            Ship anyway →
          </button>
        </div>
      </div>
    </dialog>
  <% end %>

  <% if is_member && (@hackatime_linked || @test_time_granted) %>
    <%# Step 1 — "what is a ship" refresher video. %>
    <dialog id="ship-video-modal-<%= @project.id %>"
            class="ship-modal"
            data-controller="modal"
            aria-label="What is a ship?">
      <div class="ship-modal__panel">
        <h3 class="ship-modal__title">Let's ship!</h3>
        <p class="ship-modal__subtitle">Here's a refresher on what a ship is.</p>
        <div class="ship-modal__video">
          <%= render VimeoEmbedComponent.new(video: :what_is_a_ship) %>
        </div>
        <div class="ship-modal__actions">
          <button type="button"
                  class="ship-modal__btn ship-modal__btn--secondary"
                  onclick="document.getElementById('ship-video-modal-' + <%= @project.id.to_json %>).close()">
            Cancel
          </button>
          <button type="button"
                  class="ship-modal__btn ship-modal__btn--primary"
                  onclick="document.getElementById('ship-video-modal-' + <%= @project.id.to_json %>).close(); document.getElementById('ship-post-modal-' + <%= @project.id.to_json %>).showModal(); document.getElementById('ship-post-modal-' + <%= @project.id.to_json %>).querySelector('.ship-modal__panel').scrollTop = 0">
            Continue →
          </button>
        </div>
      </div>
    </dialog>

    <%# Step 2 — the ship post itself: looks like a ship card, but the body is
        an editable textarea, and "Ship!" submits straight to ships#create. %>
    <dialog id="ship-post-modal-<%= @project.id %>"
            class="ship-modal ship-modal--post"
            data-controller="modal composer"
            data-composer-max-files-value="<%= Post::ShipEvent::MAX_ATTACHMENTS %>"
            data-composer-simple-mode-value="true"
            data-composer-target="dropZone"
            data-action="drop->composer#drop dragover->composer#dragover dragleave->composer#dragleave"
            aria-label="Ship your project">
      <%= form_with url: project_ships_path(@project),
                    method: :post,
                    multipart: true,
                    data: { turbo: false, action: "paste->composer#paste" },
                    html: { class: "ship-modal__form" } do |form| %>
        <% ship_mission = @project.current_mission %>
        <% ship_to_mission = ship_mission && !@project.shipped_to_mission?(ship_mission) %>

        <% if ship_to_mission %>
          <div class="ship-modal__mission-card">
            <p class="ship-modal__mission-heading">
              Shipping to <strong><%= ship_mission.name %></strong>
            </p>
            <% if ship_mission.submission_guide.present? %>
              <div class="ship-modal__mission-guide">
                <%= render MarkdownContentComponent.new(markdown: ship_mission.submission_guide, flavor: :guide) %>
              </div>
              <label class="ship-modal__mission-ack">
                <%= check_box_tag :mission_submission_guide_acknowledged, "1", false, required: true %>
                <span>I confirm my project meets the mission guidelines above</span>
              </label>
            <% end %>
          </div>
        <% end %>

        <div class="ship-modal__panel">
          <article class="ship-modal__preview">
            <header class="project-show__latest-ship-label">
              <%= inline_svg_tag "icons/sticker.svg", class: "project-show__latest-ship-icon" %>
              <span>Ship</span>
            </header>

            <div class="ship-modal__preview-body">
              <div class="project-show__latest-ship-avatar">
                <%= image_tag current_user.avatar, alt: current_user.display_name, class: "project-show__avatar project-show__avatar--lg" %>
              </div>

              <div class="ship-modal__preview-content" data-controller="textarea-hint">
                <p class="project-show__latest-ship-heading">
                  <span class="project-show__latest-ship-author">@<%= current_user.display_name %></span>
                  <span class="project-show__latest-ship-on">on</span>
                  <span class="project-show__latest-ship-project"><%= @project.title %></span>
                  <span class="project-show__latest-ship-time">· just now</span>
                </p>

                <%= form.text_area :ship_update,
                      class: "ship-modal__textarea",
                      rows: 4,
                      required: true,
                      maxlength: Post::ShipEvent::BODY_MAX_LENGTH,
                      placeholder: "What did you make? What was challenging? What are you proud of? What should people know so they can test your project?",
                      aria: { label: "Ship update" },
                      data: { composer_target: "textarea",
                              controller: "mention-autocomplete",
                              action: "paste->textarea-hint#paste input->composer#autogrow input->composer#refreshSubmit keydown->mention-autocomplete#onKeydown input->mention-autocomplete#onInput blur->mention-autocomplete#onBlur" } %>
                <p class="textarea-hint" data-textarea-hint-target="hint">Please write this yourself, humans read it!</p>

                <div class="feed-composer__attach-wrap feed-composer__attach-wrap--expanded" data-composer-target="attachWrap">
                  <label class="feed-composer__attach">
                    <%= inline_svg_tag "icons/paper.svg", class: "feed-composer__attach-icon" %>
                    <span class="feed-composer__attach-text">Add a screenshot of your project in action!</span>
                    <%= file_field_tag "ship_event[attachments][]",
                          multiple: true,
                          accept: Post::ShipEvent::ACCEPTED_CONTENT_TYPES.join(","),
                          class: "feed-composer__file-input",
                          required: true,
                          data: { composer_target: "fileInput", action: "change->composer#selectFiles" } %>
                  </label>
                </div>

                <div class="feed-composer__grid" data-composer-target="grid" data-count="0" hidden></div>

                <ul class="project-show__latest-ship-stats" aria-label="Project totals">
                  <li class="profile-project-card__meta-item">
                    <%= inline_svg_tag "icons/devlogs.svg", class: "profile-project-card__meta-icon" %>
                    <span><%= pluralize(@project.devlogs_count, "devlog") %></span>
                  </li>
                  <li class="profile-project-card__meta-item profile-project-card__meta-item--time">
                    <%= inline_svg_tag "icons/time.svg", class: "profile-project-card__meta-icon profile-project-card__meta-icon--time" %>
                    <span><%= total_hours %>h</span>
                  </li>
                  <% if ship_to_mission %>
                    <li class="profile-project-card__meta-item profile-project-card__meta-item--mission">
                      <%= inline_svg_tag "icons/flag.svg", class: "profile-project-card__meta-icon profile-project-card__meta-icon--mission" %>
                      <span>
                        <%= link_to ship_mission.name, mission_path(ship_mission.slug),
                                    class: "project-show__latest-ship-mission-link",
                                    data: { turbo_frame: "_top" } %>
                      </span>
                    </li>
                  <% end %>
                </ul>

                <% if @project.demo_url.present? || @project.repo_url.present? %>
                  <div class="project-show__latest-ship-cta">
                    <% if @project.demo_url.present? %>
                      <%= link_to @project.hardware? ? "Video of Project →" : "Try project →", @project.demo_url,
                                  target: "_blank", rel: "noopener",
                                  class: "project-show__latest-ship-btn project-show__latest-ship-btn--primary" %>
                    <% end %>
                    <% if @project.repo_url.present? %>
                      <%= link_to "See source code →", @project.repo_url,
                                  target: "_blank", rel: "noopener",
                                  class: "project-show__latest-ship-btn" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </article>

          <div class="ship-modal__actions">
            <button type="button"
                    class="ship-modal__btn ship-modal__btn--secondary"
                    onclick="document.getElementById('ship-post-modal-' + <%= @project.id.to_json %>).close()">
              Cancel
            </button>
            <%= form.submit "Ship!", class: "ship-modal__btn ship-modal__btn--primary", data: { disable_with: "Shipping…", composer_target: "submit" } %>
          </div>
        </div>
      <% end %>
    </dialog>

    <%# Funding request popup — design-stage hardware only. Mirrors the ship
        post modal but collects a complexity tier + requested amount. %>
    <% if Flipper.enabled?(:hardware_flow, current_user) && @project.design_stage? %>
      <dialog id="funding-request-modal-<%= @project.id %>"
              class="ship-modal ship-modal--post funding-modal"
              data-controller="modal"
              aria-label="Request project funding">
        <% if @project.awards_design_kit? %>
        <%= form_with url: project_funding_request_path(@project),
                      method: :post,
                      data: { turbo: false },
                      html: { class: "ship-modal__form" } do |form| %>
          <div class="ship-modal__panel funding-modal__panel">
            <header class="funding-modal__header">
              <h2 class="funding-modal__title">Submit your design</h2>
              <p class="funding-modal__tagline">Get your design approved and we'll ship you the kit to build a <%= @project.current_mission.name %>.</p>
            </header>

            <p class="funding-modal__note">
              Once a reviewer approves your design, your kit becomes available to redeem and your project moves to the build stage.
            </p>

            <div class="ship-modal__actions">
              <button type="button"
                      class="ship-modal__btn ship-modal__btn--secondary"
                      onclick="document.getElementById('funding-request-modal-' + <%= @project.id.to_json %>).close()">
                Cancel
              </button>
              <%= form.submit "Submit design", class: "ship-modal__btn ship-modal__btn--primary funding-modal__submit", data: { disable_with: "Submitting…" } %>
            </div>
          </div>
        <% end %>
        <% else %>
        <%= form_with url: project_funding_request_path(@project),
                      method: :post,
                      data: { turbo: false },
                      html: { class: "ship-modal__form", onsubmit: "return fundingSubmit(this)", data: { tier_maxes: Certification::FundingRequest::TIER_MAX_DOLLARS.to_json } } do |form| %>
          <div class="ship-modal__panel funding-modal__panel">
            <header class="funding-modal__header">
              <h2 class="funding-modal__title">Get your build funded</h2>
              <p class="funding-modal__tagline">Tell us what you're making and what it'll cost.</p>
            </header>

            <fieldset class="funding-modal__tiers">
              <legend>Pick your complexity tier</legend>
              <% Certification::FundingRequest::TIERS.each do |tier_id, t| %>
                <label class="funding-tier funding-tier--<%= t[:code].downcase %>">
                  <%= form.radio_button :complexity_tier, tier_id, required: true, class: "funding-tier__input", onchange: "fundingValidate(this.form)" %>
                  <span class="funding-tier__badge"><%= t[:code] %></span>
                  <span class="funding-tier__info">
                    <span class="funding-tier__name"><%= t[:name] %></span>
                    <span class="funding-tier__examples"><%= t[:examples] %></span>
                  </span>
                  <span class="funding-tier__max">up to $<%= t[:max_cents] / 100 %></span>
                </label>
              <% end %>
            </fieldset>

            <label class="funding-modal__amount">
              <span>Amount requested ($)</span>
              <%= form.number_field :requested_amount, min: 1, step: 1, required: true, class: "funding-modal__amount-input", oninput: "fundingValidate(this.form)" %>
            </label>
            <p class="funding-request__error" role="alert" hidden></p>

            <p class="funding-modal__note">
              Get your design approved and we'll issue a grant card for the approved amount. Higher tiers fund more.
              <%= link_to "How tiers work", guide_path("tiers"), class: "funding-modal__guide-link", target: "_blank", rel: "noopener" %>
            </p>

            <%# No `required`: the browser blocks submission silently when the
                control is scrolled out of view inside a dialog, so the check is
                enforced on submit instead, where it can point at itself. %>
            <label class="funding-modal__bom-check">
              <input type="checkbox" onchange="fundingValidate(this.form)">
              <span>I have a <code>BOM.csv</code> in my repository</span>
            </label>

            <div class="ship-modal__actions">
              <button type="button"
                      class="ship-modal__btn ship-modal__btn--secondary"
                      onclick="document.getElementById('funding-request-modal-' + <%= @project.id.to_json %>).close()">
                Cancel
              </button>
              <%= form.submit "Submit for funding", class: "ship-modal__btn ship-modal__btn--primary funding-modal__submit", data: { disable_with: "Submitting…" } %>
            </div>
          </div>
        <% end %>
        <% end %>
      </dialog>
      <script>
        function fundingBomLabel(form) {
          return form.querySelector(".funding-modal__bom-check");
        }

        function fundingValidate(form) {
          if (!form) return;
          var maxes = JSON.parse(form.dataset.tierMaxes || "{}");
          var tier = form.querySelector('[name="complexity_tier"]:checked');
          var amountEl = form.querySelector('[name="requested_amount"]');
          var err = form.querySelector(".funding-request__error");
          var submit = form.querySelector('[type="submit"]');
          if (!amountEl || !err || !submit) return;
          var amount = parseFloat(amountEl.value);
          var max = tier ? maxes[tier.value] : null;
          if (max != null) amountEl.max = max;

          var bomCheck = form.querySelector('.funding-modal__bom-check input[type="checkbox"]');
          var over = max != null && !isNaN(amount) && amount > max;
          err.textContent = over ? "This tier funds up to $" + max + ". Lower your request or pick a higher tier." : "";
          err.hidden = !over;
          // Only the over-max case disables the button. An unchecked BOM leaves it
          // clickable on purpose, so pressing it can explain itself.
          submit.disabled = over;

          if (bomCheck && bomCheck.checked) {
            fundingBomLabel(form).classList.remove("funding-modal__bom-check--error");
          }
        }

        function fundingSubmit(form) {
          var bomCheck = form.querySelector('.funding-modal__bom-check input[type="checkbox"]');
          if (bomCheck && !bomCheck.checked) {
            var err = form.querySelector(".funding-request__error");
            fundingBomLabel(form).classList.add("funding-modal__bom-check--error");
            if (err) {
              err.textContent = "Confirm you have a BOM.csv in your repository before submitting.";
              err.hidden = false;
            }
            bomCheck.focus();
            return false;
          }
          return true;
        }
      </script>
    <% end %>
  <% end %>

  <% if @is_member && @project.current_mission.nil? && !@project.shipped? %>
    <%= render layout: "shared/modal", locals: { id: "mission-browse-modal", title: "Browse missions", class_name: "mission-browse-modal" } do %>
      <% if @available_missions.any? %>
        <ul class="mission-browse-modal__grid">
          <% @available_missions.each do |mission| %>
            <li class="mission-browse-modal__card">
              <div class="mission-browse-modal__card-icon">
                <% if mission.icon.attached? %>
                  <%= image_tag mission.icon, alt: "", class: "mission-browse-modal__card-icon-img" %>
                <% else %>
                  <span class="mission-browse-modal__card-icon-fallback" aria-hidden="true">&#10022;</span>
                <% end %>
              </div>

              <div class="mission-browse-modal__card-body">
                <h3 class="mission-browse-modal__card-title"><%= mission.name %></h3>
                <p class="mission-browse-modal__card-desc"><%= truncate(mission.description.to_s, length: 120) %></p>

                <ul class="mission-browse-modal__card-meta">
                  <% if mission.difficulty.present? %>
                    <li class="mission-browse-modal__card-chip mission-browse-modal__card-chip--<%= mission.difficulty %>">
                      <%= mission.difficulty.titleize %>
                    </li>
                  <% end %>
                  <% if mission.steps_count > 0 %>
                    <li class="mission-browse-modal__card-chip"><%= mission.steps_count %>-step guide</li>
                  <% end %>
                </ul>
              </div>

              <div class="mission-browse-modal__card-actions">
                <%= link_to "Learn more",
                            mission_path(mission.slug),
                            class: "action-btn action-btn--small action-btn--secondary",
                            data: { turbo: false } %>
                <%= button_to "Attach",
                              project_mission_path(@project),
                              method: :post,
                              params: { mission_slug: mission.slug },
                              data: { turbo: false },
                              class: "action-btn action-btn--small action-btn--primary" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mission-browse-modal__empty">
          You're already on a mission for every available challenge — nice! Check back later for new missions.
        </p>
      <% end %>
    <% end %>
  <% end %>

  <%= render DiscoverRailComponent.new %>

  <dialog id="delete-project-modal" class="delete-project-modal" data-controller="modal">
    <div class="delete-project-modal__body">
      <h3 class="delete-project-modal__title">Delete project?</h3>
      <p class="delete-project-modal__text">Are you sure you want to permanently delete this project? This action cannot be undone.</p>
      <p class="delete-project-modal__warning">All devlogs, followers, and associated data will be removed.</p>
      <div class="delete-project-modal__actions">
        <button type="button" class="delete-project-modal__btn delete-project-modal__btn--cancel" onclick="document.getElementById('delete-project-modal').close()">Cancel</button>
        <button type="submit" form="delete-project-form" class="delete-project-modal__btn delete-project-modal__btn--delete">Yes, delete it</button>
      </div>
    </div>
  </dialog>

  <dialog id="followers-modal"
          class="followers-modal"
          data-profile-modal-target="dialog"
          data-action="click->profile-modal#backdropClose">
    <header class="followers-modal__header">
      <h2 class="followers-modal__title" data-profile-modal-target="title">Followers</h2>
      <button type="button" class="followers-modal__close" data-action="click->profile-modal#close" aria-label="Close">×</button>
    </header>
    <div class="followers-modal__body" data-profile-modal-target="body">
      <p class="followers-modal__loading">Loading…</p>
    </div>
  </dialog>

  <% if is_member && @project.hardware? && current_user && !current_user.has_dismissed?("hardware_update") %>
    <%= render "projects/hardware_update_modal", project: @project %>
  <% end %>

</div>
