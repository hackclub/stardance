<%
  approved = decision.approved?
  message = if approved
    "This project was vetted by Shipwrights and is now up for voting. You can ship again after making more updates."
  else
    "This needs changes before we can consider it shipped. Review the Shipwright feedback, make updates, then ship again."
  end
  decided_on = decision.decided_on
  reviewer = decision.reviewer
  reviewer_name = reviewer&.display_name.presence
  returned = decision.returned? && project.needs_changes? &&
    decision == project.latest_ship_review
%>

<article id="<%= dom_id(decision) %>"
         class="<%= class_names(
           "feed-post-card",
           "ship-decision-card",
           "ship-decision-card--#{decision.status}"
         ) %>">
  <header class="feed-post-card__header">
    <% if reviewer %>
      <%= link_to profile_path(reviewer.display_name), class: "feed-post-card__avatar-link", aria: { label: "@#{reviewer.display_name}" } do %>
        <%= image_tag reviewer.avatar, alt: "", class: "feed-post-card__avatar" %>
      <% end %>
    <% else %>
      <span class="feed-post-card__avatar feed-post-card__avatar--placeholder" aria-hidden="true">S</span>
    <% end %>

    <div class="feed-post-card__meta">
      <p class="feed-post-card__byline">
        <% if reviewer_name %>
          <%= render "shared/username_link", user: reviewer, link_class: "feed-post-card__author",
                      data: { turbo_frame: "_top" }, badge: false %>
        <% else %>
          <span class="feed-post-card__author">Shipwrights</span>
        <% end %>
        <span class="feed-post-card__context"><%= approved ? "approved" : "returned" %></span>
        <span class="ship-decision-card__subject">your project</span>
        <time class="feed-post-card__time" datetime="<%= decided_on.iso8601 %>" title="<%= l(decided_on, format: :long) %>">
          · <%= time_ago_in_words(decided_on) %> ago
        </time>
      </p>
    </div>
  </header>

  <div class="feed-post-card__body ship-decision-card__message">
    <p><%= message %></p>
  </div>

  <% if decision.feedback.present? %>
    <section class="feed-post-card__body ship-decision-card__feedback" aria-label="Shipwright feedback">
      <p class="ship-decision-card__feedback-label">Feedback</p>
      <div class="ship-decision-card__feedback-body">
        <%# Action items are a hardware-only affordance; software feedback stays
            plain prose, bullets and all. %>
        <% if action_items_enabled? && project.hardware? %>
          <%= render "projects/review_feedback", review: decision %>
        <% else %>
          <%= simple_format(decision.feedback, {}, sanitize: true) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if (verdict_video_src = certification_verdict_video_src(decision)) %>
    <section class="feed-post-card__body ship-decision-card__video-section" aria-label="Shipwright walkthrough video">
      <p class="ship-decision-card__video-label">Shipwright walkthrough</p>
      <div class="ship-decision-card__video-frame">
        <%= video_tag verdict_video_src,
                      controls: true,
                      playsinline: true,
                      preload: "metadata",
                      class: "ship-decision-card__video" %>
      </div>
    </section>
  <% end %>

  <% if returned %>
    <% if is_member || current_user&.can_review? %>
      <% recert_modal_id = local_assigns[:recert_modal_id] %>
      <% link_blocker = local_assigns[:link_blocker] %>
      <% if link_blocker %>
        <button type="button"
                class="recert-modal__btn recert-modal__btn--primary"
                aria-disabled="true"
                data-controller="tooltip"
                data-tooltip-message-value="<%= link_blocker %>"
                data-tooltip-position-value="top">
          Request re-certification
        </button>
      <% elsif action_items_enabled? && is_member && decision.gates_resubmission? && recert_modal_id.present? %>
        <button type="button"
                class="recert-modal__btn recert-modal__btn--primary"
                onclick="document.getElementById(<%= recert_modal_id.to_json %>).showModal()">
          Request re-certification
        </button>
      <% else %>
        <% confirm_msg = is_member ? "Have you addressed the feedback? This will re-enter the review queue." : "This will request re-certification on behalf of the user. Continue?" %>
        <%= button_to "Request re-certification",
              project_recertification_path(project),
              method: :post,
              class: "recert-modal__btn recert-modal__btn--primary",
              form: { data: { turbo_confirm: confirm_msg } } %>
      <% end %>
    <% end %>
  <% end %>
</article>
