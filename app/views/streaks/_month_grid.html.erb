<div class="streak-calendar__nav">
  <% if local_assigns.fetch(:show_prev, true) %>
    <button type="button" class="streak-calendar__nav-btn" data-action="streak#prevMonth" aria-label="Previous month">‹</button>
  <% else %>
    <span class="streak-calendar__nav-btn streak-calendar__nav-btn--disabled">‹</span>
  <% end %>
  <span class="streak-calendar__month"><%= date.strftime("%B %Y") %></span>
  <% if show_next %>
    <button type="button" class="streak-calendar__nav-btn" data-action="streak#nextMonth" aria-label="Next month">›</button>
  <% else %>
    <span class="streak-calendar__nav-btn streak-calendar__nav-btn--disabled">›</span>
  <% end %>
</div>

<%= render "streaks/month_cells", calendar_days: calendar_days %>
