<% content_for :title, "Home" %>

<% if @welcoming %>
  <%= render "welcome_tour" %>
<% end %>

<div class="app-layout">
  <main class="app-layout__main home-page" aria-label="Home">
    <div class="home-tabs">
      <nav class="home-tabs__nav" aria-label="Home sections">
        <ul class="home-tabs__list">
          <li class="home-tabs__item">
            <%= home_tab_link("explore", home_explore_path, @tab) %>
          </li>
          <li class="home-tabs__item">
            <%= home_tab_link("faq", home_faq_path, @tab) %>
          </li>
          <li class="home-tabs__item">
            <%= home_tab_link("achievements", home_achievements_path, @tab) %>
          </li>
          <li class="home-tabs__item">
            <%= home_tab_link("leaderboard", home_leaderboard_path, @tab, divider: false) %>
          </li>
        </ul>
      </nav>
    </div>

    <% case @tab %>
    <% when "explore" %>
      <div class="feed-home">
        <%= render Posts::ComposerComponent.new(
          post: @devlog,
          current_user: current_user,
          projects: @composer_projects,
          selected_project: @selected_project
        ) %>

        <% if @feed_posts.any? %>
          <% @feed_posts.each_with_index do |post, index| %>
            <% if post.postable_type == "Post::ShipEvent" %>
              <%= render "projects/ship_card", post: post, project: post.project %>
            <% else %>
              <%= render Posts::CardComponent.new(post: post, current_user: current_user) %>
            <% end %>

            <% if index.zero? && @recommended_projects.any? %>
              <%= render Feed::ShelfComponent.new(
                title: "Recommended projects",
                items: @recommended_projects
              ) do |shelf| %>
                <% @recommended_projects.each do |project| %>
                  <% shelf.with_item do %>
                    <%= render Projects::ShelfCardComponent.new(project: project) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <% if @recommended_projects.any? %>
            <%= render Feed::ShelfComponent.new(
              title: "Recommended projects",
              items: @recommended_projects
            ) do |shelf| %>
              <% @recommended_projects.each do |project| %>
                <% shelf.with_item do %>
                  <%= render Projects::ShelfCardComponent.new(project: project) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <p class="feed-home__empty">Nothing here yet. Post a devlog or ship your project to start the feed.</p>
        <% end %>
      </div>

    <% when "faq" %>
      <div class="home-faq">
        <%= render "faq_tab" %>
      </div>

    <% when "achievements" %>
      <div class="home-achievements">
        <%= render "achievements_tab" %>
      </div>

    <% when "leaderboard" %>
      <div class="home-leaderboard">
        <%= render "leaderboard_tab" %>
      </div>
    <% end %>
  </main>

  <%= render DiscoverRailComponent.new %>
</div>
