<div class="api-key-container">
  <% if user.api_key.present? %>
    <div class="api-key-display api-key-display--copyable <%= 'api-key-display--blurred' unless local_assigns[:just_generated] %>"
         data-key="<%= user.api_key %>"
         onmouseenter="this.classList.remove('api-key-display--blurred')"
         onmouseleave="<%= local_assigns[:just_generated] ? '' : "this.classList.add('api-key-display--blurred')" %>"
         onclick="navigator.clipboard.writeText(this.dataset.key); if (this.textContent !== 'Copied!') { this.dataset.orig = this.textContent; } this.textContent = 'Copied!'; clearTimeout(this._t); this._t = setTimeout(() => this.textContent = this.dataset.orig, 1500);"
         title="Click to copy">
      <%= user.api_key %>
    </div>
  <% else %>
    <div class="api-key-display">No API key yet, to generate one here -></div>
  <% end %>

  <%= button_to roll_api_key_my_settings_path,
                method: :post,
                form: { "data-turbo-confirm": user.api_key.present? ? "Rotate API key? Your current key will stop working immediately." : nil } do %>
    <%= inline_svg_tag "icons/refresh.svg", class: "api-key-generate-icon" %>
  <% end %>
</div>
<% if local_assigns[:just_generated] %>
  <p class="api-key-section__new-key-notice">New key generated — copy it now!</p>
<% end %>
