<div class="api-key-container">
  <div class="api-key-display"
       style="<%= 'filter: blur(0px);' if local_assigns[:just_generated] %>"
       onmouseenter="this.style.filter='blur(0px)'"
       onmouseleave="<%= local_assigns[:just_generated] ? '' : "this.style.filter='blur(8px)'" %>"
       <% if user.api_key.present? %>
       data-api-key="<%= user.api_key %>"
       onclick="navigator.clipboard.writeText(this.dataset.apiKey); if (this.textContent !== 'Copied!') { this.dataset.originalText = this.textContent; } this.textContent = 'Copied!'; clearTimeout(this._copyTimeout); this._copyTimeout = setTimeout(() => this.textContent = this.dataset.originalText, 1500);"
       title="Click to copy"
       <% end %>>
    <%= user.api_key.present? ? user.api_key : "No API Key, press generate!" %>
  </div>

  <%= button_to roll_api_key_my_settings_path,
                method: :post,
                form: { onsubmit: user.api_key.present? ? "return confirm('Are you sure? This will invalidate your current API key.')" : nil } do %>
    <%= inline_svg_tag "icons/refresh.svg", class: "api-key-generate-icon" %>
  <% end %>
</div>