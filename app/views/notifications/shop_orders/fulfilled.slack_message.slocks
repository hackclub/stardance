header "✅ Order ##{order.id} Fulfilled!"

section "Your order has been fulfilled and is on its way! Make sure to show off what you do with it in <#C07UMRYJ1LH> when it arrives!", markdown: true

section "Order Details:",
  fields: [
    mrkdwn_text("*Order ID:* #{order.id}"),
    mrkdwn_text("*Item:* #{order.shop_item.name}"),
    mrkdwn_text("*Quantity:* #{order.quantity}"),
    mrkdwn_text("*Total:* :stardust: #{order.total_cost}"),
    mrkdwn_text("*Fulfilled by:* #{order.fulfilled_by}"),
    (mrkdwn_text("*Order reference:* #{order.order_reference}") if order.order_reference),
  ].compact

section "*Tracking:* #{order.tracking_link.to_slack_mrkdwn}", markdown: true if order.tracking_link

divider

context [
  mrkdwn_text("Thank you for participating in Stardance with us! 🎉")
]
