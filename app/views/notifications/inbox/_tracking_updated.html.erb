<span class="notifications-item__verb">Your</span>
<% if notification.record %>
  <%= link_to notification.record.shop_item&.name || "order ##{notification.record.id}",
                 shop_orders_path,
                 class: "notifications-item__actor" %>
<% else %>
  <span class="notifications-item__verb">shop order</span>
<% end %>
<span class="notifications-item__verb">is on the way, and its tracking is ready!</span>
