<%# One-time announcement that the Sticky Streak challenge exists. Shown site
    wide to anyone who could start one, until they dismiss it or begin a run.
    Dismissal persists per account through User::StateFlags. %>
<% if current_user&.onboarded? &&
      !current_user.has_dismissed?("sticky_streak_intro") &&
      current_user.sticky_streaks_enabled? &&
      current_user.sticky_streak.nil? &&
      current_user.hackatime_identity.present? %>
  <dialog class="sticky-promo"
          data-controller="dismissable"
          data-dismissable-thing-value="sticky_streak_intro"
          data-dismissable-open-value="true"
          aria-labelledby="sticky-promo-heading">
    <div class="sticky-promo__content">
      <button type="button" class="sticky-promo__close"
              data-action="click->dismissable#dismiss" aria-label="Close">&times;</button>

      <%= image_tag "streak/comet.svg", class: "sticky-promo__hero", alt: "" %>

      <h2 class="sticky-promo__heading" id="sticky-promo-heading">Sticky streaks are here!</h2>

      <p class="sticky-promo__text">
        When you're ready, you can now start a new challenge to stay coding for as many days as
        you can! Each day you keep up your streak, you'll get a free exclusive sticker.
        <strong>If you stop at all, you'll lose the challenge and can't claim anything more.</strong>
      </p>
      <%# Literal 21: the plushie is the day 21 reward, so extending the run
          must not move this number. %>
      <p class="sticky-promo__text">
        After 21 days, you'll be able to claim a free starling plushie!
      </p>
      <p class="sticky-promo__hint">
        To get started, just open the calendar widget on the right of the home screen, and
        activate your challenge :D
      </p>

      <button type="button" class="sticky-promo__cta" data-action="click->dismissable#dismiss">
        Got it!
      </button>
    </div>
  </dialog>
<% end %>
