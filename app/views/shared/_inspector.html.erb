<%= admin_tool do %>
  <details class="inspector">
    <summary class="inspector__summary">
      <% if record.is_a?(ActiveRecord::Base) %>
        <%= record.model_name.human %> record #<%= record.id %>
      <% else %>
        inspect <%= defined?(thing) ? thing : 'object' %>
      <% end %>
    </summary>
    <pre class="inspector__body"><%== awesome_inspect(record) %></pre>
  </details>
<% end %>
