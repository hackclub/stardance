<dialog class="stardance-finale" aria-label="Stardance finale" data-stardance-finale-target="dialog" data-action="cancel->stardance-finale#preventClose">
  <p class="stardance-finale__countdown" data-stardance-finale-target="countdown" role="status" hidden></p>
  <div class="stardance-finale__fade" data-stardance-finale-target="fade" aria-hidden="true"></div>
  <div class="stardance-finale__panel" data-stardance-finale-target="panel" hidden>
    <%# The YouTube player is only embedded once the event approaches or the viewer chooses replay. %>
    <div class="stardance-finale__video" role="region" aria-label="Stardance finale video"
         data-stardance-finale-target="video" data-action="loadedmetadata->stardance-finale#videoReady canplay->stardance-finale#videoReady ended->stardance-finale#videoEnded error->stardance-finale#videoError waiting->stardance-finale#videoWaiting"></div>
    <div class="stardance-finale__controls">
      <button class="stardance-finale__button" type="button" data-stardance-finale-target="play" data-action="stardance-finale#playVideo" hidden>play with sound</button>
      <p class="stardance-finale__status" role="status" data-stardance-finale-target="status"></p>
    </div>
  </div>
  <button class="stardance-finale__button stardance-finale__button--reset" type="button" data-stardance-finale-target="previewReset" data-action="stardance-finale#resetPreview" hidden>Reset preview</button>
</dialog>
