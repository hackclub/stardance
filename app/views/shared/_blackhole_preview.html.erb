<div class="blackhole" data-controller="blackhole" data-mihi-mode-ignore>
  <svg class="blackhole__masks" aria-hidden="true" width="0" height="0" data-blackhole-target="masks"><defs></defs></svg>
  <div class="blackhole__text" aria-hidden="true" inert data-blackhole-target="text"></div>
  <canvas class="blackhole__dust" aria-hidden="true" data-blackhole-target="canvas"></canvas>
  <aside class="blackhole__panel" aria-label="Disintegration preview controls">
    <div class="blackhole__heading">
      <span class="blackhole__eyebrow"><span class="blackhole__beacon"></span> Event simulator</span>
      <span class="blackhole__badge">Preview</span>
    </div>
    <div class="blackhole__readout">
      <div>
        <h2 class="blackhole__title">Spacetime decay</h2>
        <p class="blackhole__status" data-blackhole-target="status">Spacetime is holding.</p>
      </div>
      <output class="blackhole__amount" for="blackhole-intensity" data-blackhole-target="amount">0<span>%</span></output>
    </div>
    <label class="blackhole__simple">
      <input type="checkbox" autocomplete="off" data-blackhole-target="simple" data-action="change->blackhole#toggleSimple">
      <span>Simple mode</span>
    </label>
    <div class="blackhole__phases" aria-label="Decay phases" data-blackhole-target="phases">
      <span>0–30%<strong>Edges</strong></span>
      <span>30–60%<strong>Backgrounds</strong></span>
      <span>60–82%<strong>Images</strong></span>
      <span>82–100%<strong>Text color</strong></span>
    </div>
    <label class="blackhole__label" for="blackhole-intensity">Disintegration</label>
    <input class="blackhole__slider" id="blackhole-intensity" type="range" min="0" max="100" value="0" step="1" autocomplete="off"
           data-blackhole-target="slider" data-action="input->blackhole#change">
    <div class="blackhole__presets">
      <button type="button" data-action="blackhole#preset" data-amount="0">Restore</button>
      <button type="button" data-action="blackhole#preset" data-amount="25">25%</button>
      <button type="button" data-action="blackhole#preset" data-amount="75">75%</button>
      <button type="button" data-action="blackhole#preset" data-amount="90">90%</button>
    </div>
    <p class="blackhole__hint" data-blackhole-target="hint">Hover or focus to restore cards until 60%. Images fade next; damaged text turns mint instead of disappearing.</p>
  </aside>
</div>
