<%# locals: (intensity: 0, progress_url: nil, awaiting_reveal: false, visual_intensity: 100, particles_enabled: true, disintegration_enabled: true, simulator: false, ends_at: nil, finale_seen: false, viewer_id: nil, video_url: nil) %>
<div class="blackhole" data-controller="blackhole stardance-finale" data-mihi-mode-ignore
     data-blackhole-intensity-value="<%= intensity %>"
     data-blackhole-visual-intensity-value="<%= visual_intensity %>"
     data-blackhole-particles-enabled-value="<%= particles_enabled %>"
     data-blackhole-disintegration-enabled-value="<%= disintegration_enabled %>"
     data-blackhole-simulator-enabled-value="<%= simulator %>"
     data-stardance-finale-ends-at-value="<%= ends_at&.iso8601(3) %>"
     data-stardance-finale-seen-value="<%= finale_seen %>"
     data-stardance-finale-viewer-id-value="<%= viewer_id %>"
     data-stardance-finale-preview-enabled-value="<%= simulator %>"
     data-stardance-finale-dismiss-url-value="<%= my_dismissals_path %>"
     data-blackhole-awaiting-reveal-value="<%= awaiting_reveal %>"
     data-action="stardance-finale:disintegrate->blackhole#startFinale stardance-finale:reset->blackhole#resetFinale blackhole:finale-complete->stardance-finale#showVideo buku-x3-reveal:complete@window->blackhole#revealComplete buku-x3-reveal:preview-complete@window->blackhole#revealComplete"
     data-blackhole-progress-url-value="<%= progress_url %>">
  <svg class="blackhole__masks" aria-hidden="true" width="0" height="0" data-blackhole-target="masks"><defs></defs></svg>
  <div class="blackhole__text" aria-hidden="true" inert data-blackhole-target="text"></div>
  <canvas class="blackhole__dust" aria-hidden="true" data-blackhole-target="canvas"></canvas>
  <%= render "shared/stardance_finale", video_url: video_url %>
  <%= render "shared/event_simulator", particles_enabled: particles_enabled, disintegration_enabled: disintegration_enabled if simulator %>
</div>
