<% content_for :title, @category_title %>

<div class="shop-category shop-category--mode-<%= @shop_mode %>"
     data-controller="shop"
     data-shop-user-region-value="<%= @user_region %>"
     data-shop-mode-value="<%= @shop_mode %>">

  <header class="shop-category__title-row">
    <span class="shop-category__title-divider shop-category__title-divider--left" aria-hidden="true"></span>
    <h1 class="shop-category__title"><%= @category_title %></h1>
    <span class="shop-category__title-divider shop-category__title-divider--right" aria-hidden="true"></span>
  </header>

  <% if @shop_open %>
    <% if current_user&.admin? %>
      <div class="admin-banner">
        <div class="admin-banner__content">
          <span class="admin-banner__count"><%= @shop_items.count %> items</span>
          <%= link_to "Edit items →", admin_manage_shop_path, class: "admin-banner__link" %>
        </div>
      </div>
    <% end %>

    <% if @shop_mode == :tutorial && @tutorial_items.values.all?(&:present?) %>
      <p class="shop-category__tutorial-prompt" role="status">
        <span class="shop-category__tutorial-prompt-eyebrow">Quick walkthrough</span>
        <span class="shop-category__tutorial-prompt-text">Pick <strong>stickers</strong> or <strong>nothing</strong> to learn how orders work.</span>
      </p>
    <% end %>

    <div class="shop-category__toolbar">
      <%= form_with url: shop_category_path(@slug), method: :get, local: true, class: "shop-category__search" do |f| %>
        <%= render InputComponent.new(
              label: nil,
              icon: "icons/search.svg",
              placeholder: "Search...",
              form: f,
              attribute: :q,
              color: :yellow,
              input_html: { value: params[:q], data: { action: "input->shop#search" } }
            ) %>
      <% end %>

      <div class="shop-category__filters">
        <%= render DropdownComponent.new(
              label: "Price Range",
              options: [
                { label: "None", value: "none" },
                { label: "0 - 100", value: "0-100" },
                { label: "100 - 500", value: "100-500" },
                { label: "500 - 1000", value: "500-1000" },
                { label: "> 1000", value: "1000+" }
              ],
              selected_option: "None",
              color: :pink,
              action: "change->shop#filter"
            ) %>
        <%= render DropdownComponent.new(
              label: "Access",
              options: [ "All", "Available", "Locked" ],
              selected_option: "All",
              color: :red,
              action: "change->shop#filter"
            ) %>
        <%= render DropdownComponent.new(
              label: "Sort by",
              options: [ "Prices", "Alphabetical" ],
              selected_option: "Prices",
              color: :green,
              action: "change->shop#filter"
            ) %>
        <%= render DropdownComponent.new(
              label: "Region",
              options: @region_options,
              selected_option: Shop::Regionalizable::REGIONS.dig(@user_region, :name),
              color: :blue,
              action: "change->shop#filter"
            ) %>
      </div>
    </div>

    <%= turbo_frame_tag "shop_items" do %>
      <div class="shop-category__items">
        <% tutorial_item_ids = @shop_mode == :tutorial ? @tutorial_items.values.compact.map(&:id) : [] %>
        <% @shop_items.each do |item| %>
          <% if item.image.present? && item.enabled_in_region?(@user_region) %>
            <% sale_price = item.price_for_region(@user_region) %>
            <% item_achievement_infos = item.required_achievement_objects %>
            <% item_achievement_locked = item.achievement_locked_for?(current_user) %>
            <% is_tutorial_pick = tutorial_item_ids.include?(item.id) %>
            <% item_interactive = case @shop_mode
                                 when :preview  then false
                                 when :tutorial then is_tutorial_pick
                                 else                true
                                 end %>
            <% cta_mode = case @shop_mode
                          when :preview  then :preview_locked
                          when :tutorial then is_tutorial_pick ? :tutorial_buy : :tutorial_locked
                          else                :order
                          end %>
            <%= render ShopItemCardComponent.new(
              item_id: item.id,
              name: item.name,
              description: item.description,
              hours: item.fixed_estimate(sale_price).to_i,
              price: item.ticket_cost,
              image_url: item.image.variant(:carousel_lg),
              item_type: item.type,
              balance: @user_balance,
              enabled_regions: item.enabled_region_codes,
              regional_price: sale_price,
              logged_in: current_user.present?,
              interactive: item_interactive,
              tutorial_spotlight: is_tutorial_pick && @shop_mode == :tutorial,
              cta_mode: cta_mode,
              remaining_stock: item.remaining_stock,
              limited: item.limited?,
              on_sale: item.on_sale?,
              sale_percentage: item.sale_percentage,
              original_price: item.base_price_for_region(@user_region),
              purchase_count: item.display_purchase_count,
              is_new: item.new_item?,
              enabled_until: item.enabled_until,
              locked_by_achievement: item_achievement_locked,
              required_achievement_names: item_achievement_infos.map(&:name),
              required_achievement_hints: item_achievement_infos.map(&:description)
            ) %>
          <% end %>
        <% end %>
        <% if @shop_items.empty? %>
          <p class="shop-category__empty">Nothing here yet. Check back soon.</p>
        <% end %>
        <div class="shop__empty" style="display: none;" data-shop-target="empty">
          <p>No items match your filters.</p>
        </div>
      </div>
    <% end %>

    <p class="shop-category__back">
      <%= link_to "← Back to shop", shop_path, class: "shop-category__back-link" %>
    </p>
  <% else %>
    <h2>The shop is not opened yet!</h2>
  <% end %>
</div>

<%= render "shop/suggestion_modal" if current_user && Flipper.enabled?(:shop_suggestion_box, current_user) && !current_user.has_dismissed?("shop_suggestion_box") %>
