<% content_for :title, "Shop" %>
<% content_for :og_title, "Stardance Shop" %>
<% content_for :og_description, "Spend your Stardust on stickers, hardware, and other prizes. Earn Stardust by building projects and voting!" %>
<% content_for :og_image, og_image_url('shop', format: :png) %>

<div class="shop-hub shop-hub--mode-<%= @shop_mode %>"
     data-controller="shop"
     data-shop-user-region-value="<%= @user_region %>"
     data-shop-mode-value="<%= @shop_mode %>">

  <% if @shop_mode == :preview %>
    <%= render "shop/preview_banner" %>
  <% end %>

  <% if @shop_mode == :tutorial && @tutorial_items.values.all?(&:present?) %>
    <p class="shop-hub__tutorial-prompt" role="status">
      <span class="shop-hub__tutorial-prompt-eyebrow">Quick walkthrough</span>
      <span class="shop-hub__tutorial-prompt-text">Open <strong>HQ</strong> below to pick stickers or nothing.</span>
    </p>
  <% end %>

  <div class="shop-hub__layout">
    <header class="shop-hub__topbar">
      <%= form_with url: shop_path, method: :get, local: true, class: "shop-hub__search" do |f| %>
        <%= f.search_field :q,
                           value: params[:q],
                           class: "shop-hub__search-input",
                           placeholder: "Search...",
                           "aria-label": "Search the shop",
                           autocomplete: "off" %>
        <%= inline_svg_tag "icons/search.svg", class: "shop-hub__search-icon" %>
      <% end %>

      <div class="shop-hub__topbar-right">
        <div class="shop-hub__region">
          <%= render DropdownComponent.new(
                label: "Region",
                options: @region_options,
                selected_option: Shop::Regionalizable::REGIONS.dig(@user_region, :name),
                color: :blue,
                action: "change->shop#filter"
              ) %>
        </div>

        <% if current_user && Flipper.enabled?(:shop_suggestion_box, current_user) && !current_user.has_dismissed?("shop_suggestion_box") %>
          <button type="button" class="shop-hub__suggest" onclick="document.getElementById('shop-suggestion-modal').showModal()">
            <%= image_tag "Rummage.avif", alt: "", class: "shop-hub__suggest-img" %>
            <span class="shop-hub__suggest-pill">Suggest a prize?</span>
          </button>
        <% end %>
      </div>
    </header>

    <% if @shop_open %>
      <section class="shop-hub__main">
        <ul class="shop-hub__category-grid" aria-label="Shop categories">
          <% @categories.each do |slug, config| %>
            <% category_items = config[:types] ? @shop_items.select { |i| config[:types].include?(i.type) } : @shop_items %>
            <% category_thumbs = category_items.select { |i| i.image.attached? }.first(3) %>
            <li class="shop-hub__category-tile">
              <%= link_to shop_category_path(slug), class: "shop-hub__category-link", data: { turbo: true } do %>
                <div class="shop-hub__category-art" aria-hidden="true">
                  <% if category_thumbs.any? %>
                    <% category_thumbs.each_with_index do |thumb, idx| %>
                      <%= image_tag thumb.image.variant(:carousel_sm), alt: "", class: "shop-hub__category-thumb shop-hub__category-thumb--#{idx}" %>
                    <% end %>
                  <% else %>
                    <span class="shop-hub__category-thumb-placeholder">✦</span>
                  <% end %>
                </div>
                <h2 class="shop-hub__category-name"><%= config[:hub_title] %></h2>
              <% end %>
            </li>
          <% end %>
        </ul>

        <% if @random_items&.any? %>
          <section class="shop-hub__discover" aria-label="Discover items">
            <h2 class="shop-hub__section-title">Discover</h2>
            <ul class="shop-hub__discover-grid">
              <% @random_items.each do |item| %>
                <li class="shop-hub__discover-card">
                  <%= link_to shop_order_path(shop_item_id: item.id), class: "shop-hub__discover-link", data: { turbo: true } do %>
                    <div class="shop-hub__discover-thumb-wrap">
                      <%= image_tag item.image.variant(:carousel_sm), alt: "", class: "shop-hub__discover-thumb" if item.image.attached? %>
                    </div>
                    <div class="shop-hub__discover-text">
                      <p class="shop-hub__discover-name"><%= item.name %></p>
                      <p class="shop-hub__discover-price">
                        <%= stardust_icon %>
                        <%= number_to_currency(item.price_for_region(@user_region), precision: 0).delete('$') %>
                      </p>
                    </div>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </section>

      <aside class="shop-hub__sidebar" aria-label="Shop status">
        <section class="shop-hub__sidebar-block">
          <h2 class="shop-hub__sidebar-title">YOUR ORDERS</h2>
          <% if current_user && @sidebar_orders.any? %>
            <ul class="shop-hub__sidebar-list">
              <% @sidebar_orders.each do |order| %>
                <li class="shop-hub__sidebar-card">
                  <p class="shop-hub__sidebar-card-title">Order (ID: <%= order.id %>) <%= order.aasm_state&.humanize&.downcase %></p>
                  <p class="shop-hub__sidebar-card-body"><%= truncate(order.shop_item&.name.to_s, length: 60) %></p>
                </li>
              <% end %>
            </ul>
            <%= link_to "see more →", shop_my_orders_path, class: "shop-hub__sidebar-link" %>
          <% else %>
            <p class="shop-hub__sidebar-empty">No orders yet.</p>
          <% end %>
        </section>

        <section class="shop-hub__sidebar-block">
          <h2 class="shop-hub__sidebar-title">SHOP UPDATES</h2>
          <p class="shop-hub__sidebar-empty">No updates right now.</p>
        </section>

        <section class="shop-hub__sidebar-block shop-hub__sidebar-block--wishlist">
          <h2 class="shop-hub__sidebar-title">WISHLIST</h2>

          <div class="shop-goals"
               data-controller="shop-goals"
               data-shop-goals-balance-value="<%= @user_balance %>"
               data-shop-goals-stardust-icon-url-value="<%= image_path('icons/stardust.png') %>">
            <div class="shop-goals__container" data-shop-goals-target="container" style="display: none;">
              <div class="shop-goals__items" data-shop-goals-target="items"></div>
            </div>
            <p class="shop-hub__sidebar-empty" data-shop-goals-empty>
              Tap the star on any item to add it here.
            </p>
            <script>
              try {
                var w = JSON.parse(localStorage.getItem("shop_wishlist"));
                if (w && Object.keys(w).length) {
                  document.currentScript.previousElementSibling.style.display = "none";
                  document.currentScript.previousElementSibling.previousElementSibling.style.display = "block";
                }
              } catch (e) {}
            </script>
          </div>
        </section>
      </aside>
    <% else %>
      <h2 class="shop-hub__closed">The shop is not opened yet!</h2>
    <% end %>
  </div>

  <% if current_user&.admin? %>
    <div class="admin-banner">
      <div class="admin-banner__content">
        <span class="admin-banner__count"><%= @shop_items.count %> items</span>
        <%= link_to "Edit items →", admin_shop_path, class: "admin-banner__link" %>
      </div>
    </div>
  <% end %>
</div>

<%= render "shop/suggestion_modal" if current_user && Flipper.enabled?(:shop_suggestion_box, current_user) && !current_user.has_dismissed?("shop_suggestion_box") %>
