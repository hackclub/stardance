<% stickers = tutorial_items[:stickers] %>
<% nothing  = tutorial_items[:nothing] %>

<section class="shop-tutorial" aria-live="polite">
  <div class="shop-tutorial__body">
    <p class="shop-tutorial__eyebrow">welcome to the shop</p>
    <h2 class="shop-tutorial__title">Pick one — let's walk through how this works.</h2>
    <p class="shop-tutorial__lede">You'll go through the checkout flow once so you know what to expect before you ever spend real Stardust. The rest of the shop unlocks as soon as you're done.</p>
    <% unless user.identity_verified? %>
      <p class="shop-tutorial__lede shop-tutorial__lede--alert">First we'll need you to verify your identity — that's how we know where to send things.</p>
    <% end %>
  </div>

  <div class="shop-tutorial__tiles">
    <%= link_to shop_order_path(shop_item_id: stickers.id),
                class: "shop-tutorial__tile shop-tutorial__tile--stickers",
                data: { turbo_frame: "_top" } do %>
      <div class="shop-tutorial__tile-art">
        <%= image_tag stickers.image.variant(:carousel_lg), alt: "", class: "shop-tutorial__tile-img" %>
      </div>
      <div class="shop-tutorial__tile-content">
        <h3 class="shop-tutorial__tile-title">Stickers</h3>
        <p class="shop-tutorial__tile-desc">A pack on us. We'll mail them anywhere.</p>
        <span class="shop-tutorial__tile-cta">Pick stickers →</span>
      </div>
    <% end %>

    <%= link_to shop_order_path(shop_item_id: nothing.id),
                class: "shop-tutorial__tile shop-tutorial__tile--nothing",
                data: { turbo_frame: "_top" } do %>
      <div class="shop-tutorial__tile-art shop-tutorial__tile-art--minimal">
        <span aria-hidden="true">—</span>
      </div>
      <div class="shop-tutorial__tile-content">
        <h3 class="shop-tutorial__tile-title">Nothing</h3>
        <p class="shop-tutorial__tile-desc">Just learn the flow — no swag this round.</p>
        <span class="shop-tutorial__tile-cta">Skip the freebie →</span>
      </div>
    <% end %>
  </div>
</section>
