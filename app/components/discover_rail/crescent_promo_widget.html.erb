<section class="crescent-promo"
         aria-label="Crescent, a Hack Club YSWS"
         data-controller="crescent-sky"
         data-action="pointerenter->crescent-sky#enter pointerleave->crescent-sky#leave pointermove->crescent-sky#track">
  <canvas class="crescent-promo__canvas" data-crescent-sky-target="canvas" aria-hidden="true"></canvas>

  <%= link_to helpers.crescent_promo_path,
        class: "crescent-promo__link",
        target: "_blank",
        rel: "noopener",
        aria: { label: "Pick a card, any card: ship something every week on Crescent" } do %>
    <%= image_tag "crescent-logo.webp", alt: "", class: "crescent-promo__logo" %>
    <span class="crescent-promo__tagline">pick a card, <em class="crescent-promo__accent">any card...</em></span>

    <span class="crescent-promo__hand" data-crescent-sky-target="light">
      <% CARDS.each do |card, face| %>
        <span class="crescent-promo__card crescent-promo__card--<%= card %>">
          <%= image_tag face, alt: "", class: "crescent-promo__face" %>
        </span>
      <% end %>
    </span>
  <% end %>
</section>
