<section class="torque-promo" aria-label="Torque, a Hack Club YSWS">
  <%= link_to helpers.torque_promo_path, class: "torque-promo__card" do %>
    <%= image_tag "torque/wordmark.webp", alt: "Torque", class: "torque-promo__wordmark" %>
    <span class="torque-promo__scene">
      <%= image_tag "torque/orpheus.webp", alt: "", class: "torque-promo__orpheus" %>
      <%= image_tag "torque/car.webp", alt: "", class: "torque-promo__car" %>
    </span>
    <span class="torque-promo__pitch">Build anything with a motor and we'll fund the parts.</span>
    <span class="torque-promo__button">Start building</span>
  <% end %>
</section>
