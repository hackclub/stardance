<section class="rocket-progress">
  <%= image_tag "rocket_progress/wrench-buddy.png", class: "rocket-progress__avatar", alt: "" %>

  <div class="rocket-progress__body">
    <div class="rocket-progress__header">
      <h2 class="rocket-progress__eyebrow">Rocket repair</h2>
      <p class="rocket-progress__count">
        <span class="rocket-progress__hours"><%= display_hours %></span>
        <span class="rocket-progress__goal">/ <%= display_goal %> hours</span>
      </p>
    </div>

    <div class="rocket-progress__meter" style="--rocket-progress-fill: <%= fill_percent %>%; --rocket-progress-contribution: <%= contribution_percent %>%">
      <div class="progress-bar rocket-progress__bar"
           role="progressbar"
           aria-valuenow="<%= [hours, goal].min %>"
           aria-valuemin="0"
           aria-valuemax="<%= goal %>"
           aria-label="<%= progress_label %>">
        <div class="progress-bar__fill">
          <% if contribution? %>
            <span class="rocket-progress__contribution" aria-hidden="true"></span>
          <% end %>
        </div>
      </div>
      <% if contribution? %>
        <div class="rocket-progress__contribution-caption">
          <span class="rocket-progress__contribution-label">
            <span aria-hidden="true">✦</span> You contributed <strong><%= display_contribution %> h</strong>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="rocket-progress__hover-copy" aria-hidden="true">
    <p>Every hour that you or any stardancer codes adds to the rocket's build progress! Once the repairs are complete, everyone who's contributed at least five hours gets limited-edition stickers :D</p>
  </div>
</section>
